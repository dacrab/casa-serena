---
import { Image } from 'astro:assets';
import aboutImg from '../assets/images/about.webp';

const stats = [
  { n: '8',    label: 'Acres' },
  { n: '180°', label: 'Caldera View' },
  { n: '4',    label: 'Suites' },
];
---

<section id="intro" data-nav-theme="light" class="bg-warm-white">
  <div class="grid md:grid-cols-[3fr_2fr] md:min-h-[80vh]">
    <div data-anim="img" class="overflow-hidden aspect-[4/3] md:aspect-auto md:min-h-0">
      <Image
        src={aboutImg}
        alt="Casa Serena living space"
        loading="lazy"
        class="w-full h-full object-cover"
      />
    </div>

    <div class="flex flex-col justify-center gap-8 md:gap-10 section-px py-10 md:py-[10vh]">
      <div>
        <p class="label-xs text-driftwood mb-5">Est. 1987 · Reimagined 2019</p>
        <h2 class="font-serif italic font-light text-charcoal leading-tight mb-5 heading-lg">
          A house that breathes.
        </h2>
        <p data-anim="body" class="text-charcoal/80 leading-relaxed border-l border-terracotta pl-5">
          Designed to dissolve boundaries between interior and ocean,
          Casa Serena is where architecture whispers rather than shouts.
        </p>
      </div>

      <div class="flex justify-center md:justify-start gap-8 sm:gap-10 pt-8 border-t border-driftwood/20">
        {stats.map(({ n, label }) => (
          <div data-anim="stat">
            <div class="font-serif text-3xl sm:text-4xl font-light text-terracotta">{n}</div>
            <div class="label-xs text-driftwood mt-1">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
