---
import { Image } from 'astro:assets';
---
<script>
import { gsap } from '../lib/gsap';
const tl = gsap.timeline({ scrollTrigger: { trigger: '#intro', start: 'top 70%' } });
tl.from('#intro .intro-img', { opacity: 0, scale: 1.04, duration: 1.1, ease: 'power2.out' })
  .from('#intro h2',         { opacity: 0, y: 30, duration: 0.9, ease: 'power3.out' }, '-=0.6')
  .from('#intro .intro-body',{ opacity: 0, x: -16, duration: 0.7 }, '-=0.4')
  .from('.stat',             { opacity: 0, y: 16, stagger: 0.12, duration: 0.5 }, '-=0.3');
</script>

<section id="intro" data-nav-theme="light" class="bg-warm-white">
  <div class="grid md:grid-cols-[3fr_2fr] min-h-[80vh]">

    <!-- Full-bleed image -->
    <div class="intro-img overflow-hidden min-h-[50vw] md:min-h-0">
      <Image
        src="/images/about.jpg"
        alt="Casa Serena living space"
        width={1200} height={900}
        loading="eager"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Text + stats -->
    <div class="flex flex-col justify-center gap-10 section-px py-[10vh]">
      <div>
        <p class="label-xs text-driftwood mb-6">Est. 1987 · Reimagined 2019</p>
        <h2 class="font-serif italic font-light text-charcoal leading-tight mb-6" style="font-size: clamp(2rem, 4vw, 3.5rem)">
          A house that breathes.
        </h2>
        <p class="intro-body text-charcoal/80 leading-relaxed border-l border-terracotta pl-5">
          Designed to dissolve boundaries between interior and ocean, Casa Serena is where architecture whispers rather than shouts.
        </p>
      </div>

      <div class="flex gap-10 pt-8 border-t border-driftwood/20">
        <div class="stat">
          <div class="font-serif text-4xl font-light text-terracotta">8</div>
          <div class="label-xs text-driftwood mt-1">Acres</div>
        </div>
        <div class="stat">
          <div class="font-serif text-4xl font-light text-terracotta">180°</div>
          <div class="label-xs text-driftwood mt-1">Caldera View</div>
        </div>
        <div class="stat">
          <div class="font-serif text-4xl font-light text-terracotta">4</div>
          <div class="label-xs text-driftwood mt-1">Suites</div>
        </div>
      </div>
    </div>

  </div>
</section>
