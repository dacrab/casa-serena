---
import { Image } from 'astro:assets';
---
<script>
import { gsap } from '../lib/gsap';

gsap.from('#about img', { opacity: 0, y: 20, duration: 0.8, scrollTrigger: { trigger: '#about', start: 'top 80%' } });
gsap.from('#about p', { opacity: 0, y: 20, duration: 0.8, delay: 0.2, scrollTrigger: { trigger: '#about', start: 'top 80%' } });
gsap.from('.stat', { opacity: 0, y: 20, stagger: 0.1, duration: 0.6, delay: 0.4, scrollTrigger: { trigger: '.stat', start: 'top 85%' } });
</script>

<section id="about" data-nav-theme="light" class="bg-warm-white py-[8vh] section-px">
  <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
    <Image src="/images/about.jpg" alt="Casa Serena living space" width={900} height={506} format="webp" quality={85} loading="lazy" class="w-full aspect-video object-cover" />
    <div>
      <p class="text-charcoal leading-relaxed mb-8">Built in 1987 and completely reimagined in 2019, Casa Serena is an exercise in restraint. Floor-to-ceiling glass dissolves the boundary between interior and ocean.</p>
      <div class="flex gap-12">
        <div class="stat">
          <div class="font-serif text-4xl font-light text-terracotta">8</div>
          <div class="label-xs text-driftwood">Acres</div>
        </div>
        <div class="stat">
          <div class="font-serif text-4xl font-light text-terracotta">180°</div>
          <div class="label-xs text-driftwood">Caldera View</div>
        </div>
        <div class="stat">
          <div class="font-serif text-4xl font-light text-terracotta">4</div>
          <div class="label-xs text-driftwood">Suites</div>
        </div>
      </div>
    </div>
  </div>
</section>

