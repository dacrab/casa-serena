---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  label: string;
  title: string;
  subtitle?: string;
  index?: string;
}

const { image, alt, label, title, subtitle, index } = Astro.props;
---

<section data-hero class="relative flex min-h-[72svh] items-end overflow-hidden bg-ink text-paper">
  <Image
    data-intro
    src={image}
    alt={alt}
    widths={[480, 960, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover img-grade"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/15 to-ink/90"></div>

  <div class="shell relative w-full pb-10 pt-32 md:pb-14">
    <div data-intro class="flex items-center justify-between border-t border-paper/25 pt-5">
      <p class="label text-paper/60">{label}</p>
      {index && <p class="label text-paper/40">{index}</p>}
    </div>
    <h1 data-intro class="display-lg mt-7 md:mt-9">{title}</h1>
    {subtitle && <p data-intro class="label mt-5 text-paper/55">{subtitle}</p>}
  </div>
</section>
