---
import { site, socialLinks } from '../lib/site';
import { suites } from '../data/suites';

const suiteOptions = [
  { value: '', label: 'No preference' },
  ...suites.map(({ name, index }) => ({ value: name, label: `${index} — ${name}` })),
];
---

<section id="enquire" class="bg-charcoal py-16 md:py-24 section-px">
  <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_2fr] gap-12 md:gap-20">
    <div data-reveal class="flex flex-col justify-between gap-8">
      <div>
        <p class="label-xs text-driftwood mb-4">Private Estate · Santorini</p>
        <h2 class="font-serif italic font-light text-cream heading-xl leading-none">Stay.</h2>
      </div>
      <address class="not-italic">
        <a href={`mailto:${site.email}`} class="block text-cream/70 hover:text-terracotta transition-colors text-sm py-1">{site.email}</a>
        <a href={`tel:${site.phoneHref}`} class="block text-cream/70 hover:text-terracotta transition-colors text-sm py-1">{site.phone}</a>
        <div class="flex gap-4 label-xs text-driftwood mt-4">
          {socialLinks.map(({ href, label }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-cream transition-colors">
              {label}<span class="sr-only"> (opens in new tab)</span>
            </a>
          ))}
        </div>
      </address>
    </div>

    <form id="enquire-form" class="space-y-6">
      <div data-reveal class="grid grid-cols-2 gap-6">
        <label class="block">
          <span class="label-xs text-driftwood block mb-2">Arrival</span>
          <input id="arrival" type="date" name="arrival" class="form-input" />
        </label>
        <label class="block">
          <span class="label-xs text-driftwood block mb-2">Departure</span>
          <input id="departure" type="date" name="departure" class="form-input" />
        </label>
      </div>

      <div data-reveal>
        <label for="suite" class="label-xs text-driftwood block mb-2">Suite</label>
        <select id="suite" name="suite" class="form-input">
          {suiteOptions.map(({ value, label }) => (
            <option value={value}>{label}</option>
          ))}
        </select>
      </div>

      <div data-reveal>
        <label for="name" class="label-xs text-driftwood block mb-2">Name</label>
        <input id="name" name="name" required class="form-input" />
      </div>
      <div data-reveal>
        <label for="email" class="label-xs text-driftwood block mb-2">Email</label>
        <input id="email" type="email" name="email" required class="form-input" />
      </div>
      <div data-reveal>
        <label for="message" class="label-xs text-driftwood block mb-2">
          Message <span class="opacity-60 italic">(optional)</span>
        </label>
        <textarea id="message" name="message" rows="3" class="form-input resize-none"></textarea>
      </div>

      <button data-reveal type="submit" class="btn-outline label-xs w-full">
        Send Enquiry
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('enquire-form') as HTMLFormElement | null;
  if (!form) throw new Error('Enquire form missing');

  const suite = new URLSearchParams(location.search).get('suite');
  const select = document.getElementById('suite') as HTMLSelectElement | null;
  if (suite && select && [...select.options].some(o => o.value === suite)) select.value = suite;

  const arrival = document.getElementById('arrival') as HTMLInputElement;
  const departure = document.getElementById('departure') as HTMLInputElement;
  const today = new Date().toISOString().slice(0, 10);
  arrival.min = today;
  departure.min = today;
  arrival.addEventListener('change', () => { if (arrival.value) departure.min = arrival.value; });

  const $input = (id: string) => form.querySelector<HTMLInputElement>(`#${id}`)!;
  const showError = (el: HTMLElement, msg: string) => {
    el.classList.add('border-red-400');
    let err = el.nextElementSibling;
    if (!err?.classList.contains('field-error')) {
      err = document.createElement('p');
      err.className = 'field-error text-red-400 text-xs mt-1';
      el.after(err);
    }
    err!.textContent = msg;
  };
  const clearError = (el: HTMLElement) => {
    el.classList.remove('border-red-400');
    const err = el.nextElementSibling;
    if (err?.classList.contains('field-error')) err.remove();
  };

  form.querySelectorAll<HTMLInputElement>('input, select, textarea').forEach(el =>
    el.addEventListener('input', () => clearError(el)));

  form.addEventListener('submit', e => {
    e.preventDefault();
    const name = $input('name'), email = $input('email');
    [name, email].forEach(clearError);
    let valid = true;
    if (!name.value.trim()) { showError(name, 'Please enter your name'); valid = false; }
    if (!email.value.trim()) { showError(email, 'Please enter your email'); valid = false; }
    else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) { showError(email, 'Please enter a valid email'); valid = false; }
    if (arrival.value && departure.value && departure.value < arrival.value) { showError(departure, 'Departure must be after arrival'); valid = false; }
    if (!valid) return;

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Sending…';
    setTimeout(() => {
      form.innerHTML = `
        <div class="text-center py-8">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full border-2 border-terracotta flex items-center justify-center">
            <svg class="w-6 h-6 text-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
            </svg>
          </div>
          <p class="text-cream text-xl font-serif italic mb-2">Thank you.</p>
          <p class="text-cream/60 text-sm">We'll respond within 24 hours with availability and next steps.</p>
        </div>`;
    }, 800);
  });
</script>