---
const social = [
  { href: 'https://instagram.com', label: 'Instagram' },
  { href: 'https://facebook.com', label: 'Facebook' },
];
---

<section id="enquire" data-nav-theme="dark" class="bg-charcoal py-16 md:py-24 section-px">
  <div class="max-w-5xl mx-auto grid md:grid-cols-[1fr_2fr] gap-12 md:gap-20">
    <div data-anim="info" class="flex flex-col justify-between gap-8">
      <div>
        <p class="label-xs text-driftwood mb-4">Private Estate · Santorini</p>
        <h2 class="font-serif italic font-light text-cream heading-xl leading-none">Stay.</h2>
      </div>
      <address class="not-italic">
        <a href="mailto:info@casaserena.com" class="block text-cream/70 hover:text-terracotta transition-colors text-sm py-1">info@casaserena.com</a>
        <a href="tel:+302286000000" class="block text-cream/70 hover:text-terracotta transition-colors text-sm py-1">+30 22860 00000</a>
        <div class="flex gap-4 label-xs text-driftwood mt-4">
          {social.map(({ href, label }) => (
            <a href={href} target="_blank" rel="noopener noreferrer" class="hover:text-cream transition-colors">
              {label}<span class="sr-only"> (opens in new tab)</span>
            </a>
          ))}
        </div>
      </address>
    </div>

    <form id="enquire-form" class="space-y-6">
      <div data-anim="field" id="date-section" class="relative z-20">
        <p class="label-xs text-driftwood mb-2">Dates</p>
        <div class="flex gap-px border-b border-cream/20">
          <button id="btn-arrival" type="button" class="flex-1 text-left py-3 pr-4 min-h-[44px]">
            <span id="lbl-arrival" class="label-xs text-driftwood/60 block mb-0.5">Arrival</span>
            <span id="val-arrival" class="text-sm text-cream/40">Select date</span>
          </button>
          <div class="w-px bg-cream/10 self-stretch mx-2" aria-hidden="true"></div>
          <button id="btn-departure" type="button" class="flex-1 text-left py-3 pl-2 min-h-[44px]">
            <span id="lbl-departure" class="label-xs text-driftwood/60 block mb-0.5">Departure</span>
            <span id="val-departure" class="text-sm text-cream/40">Select date</span>
          </button>
        </div>
        <input type="hidden" id="arrival" name="arrival" />
        <input type="hidden" id="departure" name="departure" />

        <div id="cal-wrap" hidden class="absolute top-full left-0 right-0 mt-1 z-50 bg-surface border border-cream/10 p-4 shadow-2xl">
          <div class="flex justify-between items-center mb-3">
            <button id="cal-prev" type="button" aria-label="Previous month"
              class="text-driftwood/60 hover:text-cream transition-colors w-11 h-11 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/>
              </svg>
            </button>
            <span id="cal-title" class="label-xs text-cream"></span>
            <button id="cal-next" type="button" aria-label="Next month"
              class="text-driftwood/60 hover:text-cream transition-colors w-11 h-11 flex items-center justify-center">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>
              </svg>
            </button>
          </div>
          <div id="cal-grid" aria-live="polite" class="grid grid-cols-7 gap-y-0.5"></div>
        </div>
      </div>

      <div data-anim="field">
        <label for="suite" class="label-xs text-driftwood block mb-2">Suite</label>
        <select id="suite" name="suite" class="form-input">
          <option value="">No preference</option>
          <option value="Caldera Suite">01 — Caldera Suite</option>
          <option value="Aegean Suite">02 — Aegean Suite</option>
          <option value="Garden Suite">03 — Garden Suite</option>
          <option value="Cliff Studio">04 — Cliff Studio</option>
        </select>
      </div>

      <div data-anim="field">
        <label for="name" class="label-xs text-driftwood block mb-2">Name</label>
        <input id="name" name="name" required class="form-input" />
      </div>
      <div data-anim="field">
        <label for="email" class="label-xs text-driftwood block mb-2">Email</label>
        <input id="email" type="email" name="email" required class="form-input" />
      </div>
      <div data-anim="field">
        <label for="message" class="label-xs text-driftwood block mb-2">
          Message <span class="opacity-60 italic">(optional)</span>
        </label>
        <textarea id="message" name="message" rows="3" class="form-input resize-none"></textarea>
      </div>

      <button data-anim="field" type="submit"
        class="w-full py-3 px-8 border border-cream/40 text-cream label-xs min-h-[44px] hover:bg-terracotta hover:border-terracotta transition-colors duration-200">
        Send Enquiry
      </button>
    </form>
  </div>
</section>
