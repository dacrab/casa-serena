---
import { site, socialLinks } from '../lib/site';
import EnquiryForm from './EnquiryForm.astro';
---

<section id="enquire" class="section bg-ink text-paper">
  <div class="shell grid gap-14 md:grid-cols-12 md:gap-8">
    <div class="flex flex-col justify-between gap-12 md:col-span-5">
      <div>
        <p data-reveal class="label text-paper/45">Private estate · Santorini</p>
        <h2 data-reveal class="display-lg mt-6">
          Stay<br />
          <em>with us.</em>
        </h2>
        <p data-reveal class="body-lg mt-8 max-w-sm text-paper/65">
          Tell us when you would like to arrive. We will take care of the rest — transfers, tables, boats, and the
          particular kind of quiet you are looking for.
        </p>
      </div>

      <address class="not-italic">
        <div class="flex flex-col gap-1 border-t border-paper/15 pt-6">
          <a href={`mailto:${site.email}`} class="w-fit text-sm text-paper/75 transition-colors hover:text-paper">{site.email}</a>
          <a href={`tel:${site.phoneHref}`} class="w-fit text-sm text-paper/75 transition-colors hover:text-paper">{site.phone}</a>
        </div>
        <div class="mt-5 flex gap-5">
          {socialLinks.map(({ href, label }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              class="label text-paper/45 transition-colors hover:text-paper"
            >
              {label}<span class="sr-only"> (opens in new tab)</span>
            </a>
          ))}
        </div>
        <p class="label mt-8 text-paper/35">{site.addressLine}</p>
      </address>
    </div>

    <div data-reveal class="md:col-span-6 md:col-start-7 md:pt-4">
      <EnquiryForm theme="dark" />
    </div>
  </div>
</section>
