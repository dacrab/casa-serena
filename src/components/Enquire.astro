<script>
import { gsap } from '../lib/gsap';

const tl = gsap.timeline({ scrollTrigger: { trigger: '#enquire', start: 'top 80%' } });
tl.from('#enquire .enquire-info > *', { opacity: 0, y: 20, stagger: 0.1, duration: 0.7 })
  .from('#enquire .enquire-form > div', { opacity: 0, y: 16, stagger: 0.09, duration: 0.55 }, '-=0.4');

const DAYS = ['Su','Mo','Tu','We','Th','Fr','Sa'];
const fmtMonth = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' });
const fmtDay   = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' });

function today() { const d = new Date(); d.setHours(0,0,0,0); return d; }
// ISO string keys (YYYY-MM-DD) for all date comparisons — avoids timezone/midnight bugs
function ymd(d: Date) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function fromYmd(s: string) { const [y,m,d] = s.split('-').map(Number); return new Date(y,m-1,d); }
function setVal(id: 'arrival'|'departure', key: string|null) {
  const el = document.getElementById(`val-${id}`)!;
  el.textContent = key ? fmtDay.format(fromYmd(key)) : 'Select date';
  el.className   = key ? 'text-sm text-cream' : 'text-sm text-cream/40';
}

type Mode = 'arrival'|'departure'|null;
let selected: Record<'arrival'|'departure', string|null> = { arrival: null, departure: null };
let viewYear = today().getFullYear(), viewMonth = today().getMonth();
let activeMode: Mode = null;

const calWrap  = document.getElementById('cal-wrap')!;
// Portal to body so the calendar escapes any stacking context from the form
document.body.appendChild(calWrap);
calWrap.style.cssText = 'position:absolute;z-index:50;display:none';

const calGrid  = document.getElementById('cal-grid')!;
const calTitle = document.getElementById('cal-title')!;
const arrBtn   = document.getElementById('btn-arrival')!;
const depBtn   = document.getElementById('btn-departure')!;
const arrInput = document.getElementById('arrival')   as HTMLInputElement;
const depInput = document.getElementById('departure')  as HTMLInputElement;

function render() {
  calTitle.textContent = fmtMonth.format(new Date(viewYear, viewMonth));
  const t = today();
  const firstDow = new Date(viewYear, viewMonth, 1).getDay();
  const daysInM  = new Date(viewYear, viewMonth+1, 0).getDate();
  const arrDate  = selected.arrival   ? fromYmd(selected.arrival)   : null;
  const depDate  = selected.departure ? fromYmd(selected.departure) : null;

  let html = DAYS.map(d => `<div class="text-center label-xs text-driftwood/50 py-1">${d}</div>`).join('');
  for (let i = 0; i < firstDow; i++) html += '<div></div>';
  for (let n = 1; n <= daysInM; n++) {
    const cell = new Date(viewYear, viewMonth, n);
    const key  = ymd(cell);
    const isPast   = cell < t;
    const isEndpt  = (arrDate && key===ymd(arrDate)) || (depDate && key===ymd(depDate));
    const inRange  = arrDate && depDate && cell > arrDate && cell < depDate;
    let cls = 'text-center text-sm py-1.5 ';
    if (isPast)       cls += 'text-cream/15 cursor-not-allowed';
    else if (isEndpt) cls += 'bg-terracotta text-cream cursor-pointer font-medium';
    else if (inRange) cls += 'bg-terracotta/20 text-cream cursor-pointer';
    else              cls += 'text-cream/70 hover:text-terracotta cursor-pointer';
    html += `<div class="${cls}" data-key="${isPast?'':key}">${n}</div>`;
  }
  calGrid.innerHTML = html;
  calGrid.querySelectorAll<HTMLElement>('[data-key]').forEach(el => {
    if (!el.dataset.key) return;
    el.addEventListener('click', () => selectDate(el.dataset.key!));
  });
  setVal('arrival',   selected.arrival);
  setVal('departure', selected.departure);
  const lA = document.getElementById('lbl-arrival')!;
  const lD = document.getElementById('lbl-departure')!;
  lA.className = `label-xs block mb-0.5 ${activeMode==='arrival'   ? 'text-terracotta' : 'text-driftwood/60'}`;
  lD.className = `label-xs block mb-0.5 ${activeMode==='departure' ? 'text-terracotta' : 'text-driftwood/60'}`;
}

function selectDate(key: string) {
  if (!activeMode) return;
  selected[activeMode] = key;
  if (selected.arrival && selected.departure && selected.arrival >= selected.departure) selected.departure = null;
  arrInput.value = selected.arrival  ?? '';
  depInput.value = selected.departure ?? '';
  // Auto-advance to departure after arrival is picked
  if (activeMode === 'arrival' && !selected.departure) { activeMode = 'departure'; render(); }
  else closeCalendar();
}

function openCalendar(mode: Mode) {
  activeMode = mode;
  const ex = mode && selected[mode];
  if (ex) { const d = fromYmd(ex); viewYear = d.getFullYear(); viewMonth = d.getMonth(); }
  else { viewYear = today().getFullYear(); viewMonth = today().getMonth(); }
  const r = document.getElementById('date-section')!.getBoundingClientRect();
  calWrap.style.top   = `${r.bottom + window.scrollY + 4}px`;
  calWrap.style.left  = `${r.left}px`;
  calWrap.style.width = `${r.width}px`;
  render();
  calWrap.style.display = 'block';
  gsap.fromTo(calWrap, { opacity: 0, y: -6 }, { opacity: 1, y: 0, duration: 0.18 });
}
function closeCalendar() {
  activeMode = null;
  gsap.to(calWrap, { opacity: 0, y: -6, duration: 0.15, onComplete: () => { calWrap.style.display = 'none'; } });
  render();
}

arrBtn.addEventListener('click', e => { e.stopPropagation(); activeMode==='arrival' ? closeCalendar() : openCalendar('arrival'); });
depBtn.addEventListener('click', e => { e.stopPropagation(); activeMode==='departure' ? closeCalendar() : openCalendar('departure'); });
document.addEventListener('click', e => {
  const t = e.target as Node;
  if (!document.getElementById('date-section')!.contains(t) && !calWrap.contains(t)) closeCalendar();
});
document.getElementById('cal-prev')!.addEventListener('click', e => {
  e.stopPropagation(); viewMonth--; if (viewMonth<0){viewMonth=11;viewYear--;} render();
});
document.getElementById('cal-next')!.addEventListener('click', e => {
  e.stopPropagation(); viewMonth++; if (viewMonth>11){viewMonth=0;viewYear++;} render();
});

document.querySelector('form')!.addEventListener('submit', e => {
  e.preventDefault();
  (e.target as HTMLFormElement).innerHTML = '<p class="text-cream text-xl font-serif italic">Thank you. We\'ll be in touch.</p>';
});
</script>

<section id="enquire" data-nav-theme="dark" class="bg-charcoal py-[8vh] section-px">
  <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12">

    <div class="enquire-info">
      <p class="label-xs text-driftwood mb-4">Private Estate · Santorini</p>
      <h2 class="font-serif italic font-light text-cream mb-8" style="font-size: clamp(4rem, 12vw, 8rem)">Stay.</h2>
      <address class="not-italic space-y-2 mb-8">
        <a href="mailto:info@casaserena.com" class="block text-cream hover:text-terracotta transition">info@casaserena.com</a>
        <a href="tel:+30-22860-00000" class="block text-cream hover:text-terracotta transition">+30 22860 00000</a>
      </address>
      <div class="flex gap-4 label-xs text-driftwood">
        <a href="https://instagram.com" target="_blank" rel="noopener" class="hover:text-cream transition">Instagram</a>
        <a href="https://facebook.com" target="_blank" rel="noopener" class="hover:text-cream transition">Facebook</a>
      </div>
    </div>

    <form class="enquire-form space-y-6">

      <div id="date-section" class="relative">
        <p class="label-xs text-driftwood mb-2">Dates</p>
        <div class="flex gap-px border-b border-cream/20">
          <button id="btn-arrival" type="button" class="flex-1 text-left py-2 pr-4 cursor-pointer">
            <span id="lbl-arrival" class="label-xs text-driftwood/60 block mb-0.5">Arrival</span>
            <span id="val-arrival" class="text-sm text-cream/40">Select date</span>
          </button>
          <div class="w-px bg-cream/10 self-stretch mx-2"></div>
          <button id="btn-departure" type="button" class="flex-1 text-left py-2 pl-2 cursor-pointer">
            <span id="lbl-departure" class="label-xs text-driftwood/60 block mb-0.5">Departure</span>
            <span id="val-departure" class="text-sm text-cream/40">Select date</span>
          </button>
        </div>
        <input type="hidden" id="arrival"   name="arrival" />
        <input type="hidden" id="departure" name="departure" />
        <div id="cal-wrap" style="display:none" class="bg-[#1e1a17] border border-cream/10 p-4 shadow-2xl">
          <div class="flex justify-between items-center mb-3">
            <button id="cal-prev" type="button" class="text-driftwood/60 hover:text-cream transition px-1 cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
            </button>
            <span id="cal-title" class="label-xs text-cream"></span>
            <button id="cal-next" type="button" class="text-driftwood/60 hover:text-cream transition px-1 cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
            </button>
          </div>
          <div id="cal-grid" class="grid grid-cols-7 gap-y-0.5"></div>
        </div>
      </div>

      <div>
        <label for="name" class="label-xs text-driftwood block mb-2">Name</label>
        <input id="name" name="name" required class="form-input" />
      </div>
      <div>
        <label for="email" class="label-xs text-driftwood block mb-2">Email</label>
        <input id="email" type="email" name="email" required class="form-input" />
      </div>
      <div>
        <label for="message" class="label-xs text-driftwood block mb-2">Message <span class="opacity-60 italic">(optional)</span></label>
        <textarea id="message" name="message" rows="3" class="form-input resize-none"></textarea>
      </div>

      <button
        type="submit"
        class="w-full py-3 px-8 border border-cream/40 text-cream label-xs cursor-pointer
               hover:bg-terracotta hover:border-terracotta hover:text-white transition-all duration-200"
      >Send Enquiry</button>

    </form>
  </div>
</section>

<footer class="bg-charcoal border-t border-cream/10 py-6 section-px flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
  <span class="font-serif text-sm tracking-widest text-cream">CASA SERENA</span>
  <span class="text-xs text-driftwood">© {new Date().getFullYear()} · Santorini, Greece</span>
</footer>
