---
---

<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

/* ─────────────────────────────────────────
   GSAP defaults — luxury easing globally
───────────────────────────────────────── */
gsap.defaults({ ease: 'power3.out', overwrite: 'auto' });

/* ── initial hidden states (prevents FOUC) ── */
const sel = (s: string) => `[data-anim="${s}"]`;

gsap.set(sel('ec'),                { y: 22, opacity: 0 });
gsap.set(sel('hero-title'),        { y: 70, opacity: 0 });
gsap.set(sel('hero-scroll'),       { opacity: 0 });
gsap.set(sel('scroll-line'),       { height: 0 });
gsap.set(sel('intro-text'),        { x: 60, opacity: 0 });
gsap.set(sel('about-image-wrapper'), { x: 40, opacity: 0 });
gsap.set(sel('amenity-row'),       { x: -28, opacity: 0 });
gsap.set(sel('enquire-title'),     { y: 60, opacity: 0 });
gsap.set(sel('location-miles'),    { x: 10, opacity: 0 });
gsap.set([sel('hero-meta'), sel('enquire-eyebrow'), sel('enquire-social'), sel('quote-attribution'), sel('location-city')], { y: 16, opacity: 0 });
gsap.set([sel('intro-right-p'), sel('about-text-p'), sel('gallery-caption'), sel('enquire-right'), sel('location-desc')],   { y: 24, opacity: 0 });
gsap.set([sel('quote-text'), sel('location-address')],                                                                       { y: 40, opacity: 0 });
gsap.set([sel('quote-stat'), sel('amenities-number'), sel('footer-logo'), sel('footer-copy'), sel('form-submit')],           { y: 30, opacity: 0 });
gsap.set([sel('enquire-contact'), sel('form-group')],                                                                        { y: 20, opacity: 0 });
gsap.set([sel('stat-label'), sel('nav-link')],                                                                               { y: 10, opacity: 0 });
gsap.set([sel('enquire-rule'), sel('quote-stat-sep')], { scaleX: 0, transformOrigin: 'left center' });
gsap.set([sel('location-distance'), sel('gallery-label')],                                                                   { x: 20, opacity: 0 });
gsap.set([sel('about-sidebar'), sel('quote-stat-label'), sel('nav-logo')],                                                   { opacity: 0 });

/* ── cursor ── */
const cursor = document.getElementById('cursor');
if (cursor && window.matchMedia('(pointer: fine)').matches) {
  const moveX = gsap.quickTo(cursor, 'x', { duration: 0.55, ease: 'power3' });
  const moveY = gsap.quickTo(cursor, 'y', { duration: 0.55, ease: 'power3' });
  window.addEventListener('mousemove', e => { moveX(e.clientX - 18); moveY(e.clientY - 18); }, { passive: true });
  const interactive = `a, button, ${sel('gallery-panel')}, ${sel('amenity-row')}`;
  document.addEventListener('mouseover', e => {
    if ((e.target as Element).closest(interactive))
      gsap.to(cursor, { scale: 0.4, background: 'var(--color-terracotta)', duration: 0.2, ease: 'power2.out' });
  });
  document.addEventListener('mouseout', e => {
    if ((e.target as Element).closest(interactive))
      gsap.to(cursor, { scale: 1, background: 'transparent', duration: 0.35 });
  });
}

/* ── navbar ── */
const nav = document.querySelector('[data-nav="root"]');
if (nav) {
  ScrollTrigger.create({
    start: 'top -60',
    onEnter:      () => nav.classList.add('nav-scrolled'),
    onLeaveBack:  () => nav.classList.remove('nav-scrolled'),
  });
}

gsap.timeline({ delay: 2.5 })
  .to(sel('nav-logo'),         { opacity: 1, y: 0, duration: 0.7 })
  .to('[data-nav="link"]', { opacity: 1, y: 0, stagger: 0.07, duration: 0.55 }, '-=0.35');

/* nav link underline hover — desktop pointer only */
if (window.matchMedia('(pointer: fine)').matches) {
  document.querySelectorAll('[data-nav="link"]').forEach(link => {
    const el   = link as HTMLElement;
    const line = document.createElement('span');
    Object.assign(line.style, {
      position: 'absolute', bottom: '-2px', left: '0',
      width: '100%', height: '1px', display: 'block',
      background: 'var(--color-terracotta)', transformOrigin: 'left center', transform: 'scaleX(0)',
    });
    el.style.position = 'relative';
    el.appendChild(line);
    el.addEventListener('mouseenter', () => gsap.to(line, { scaleX: 1, duration: 0.3, ease: 'power2.out' }));
    el.addEventListener('mouseleave', () => gsap.to(line, { scaleX: 0, duration: 0.25, ease: 'power2.in', transformOrigin: 'right center' }));
  });
}

/* ── mobile menu ── */
const navToggle    = document.querySelector('[data-nav="toggle"]');
const mobileOverlay = document.createElement('div');
mobileOverlay.innerHTML = `<ul>${
  [...document.querySelectorAll('[data-nav="link"]')]
    .map(a => `<li><a href="${a.getAttribute('href')}">${a.textContent}</a></li>`)
    .join('')
}</ul>`;
Object.assign(mobileOverlay.style, {
  position:'fixed', inset:'0', background:'var(--color-charcoal)', zIndex:'998',
  display:'flex', alignItems:'center', justifyContent:'center',
  opacity:'0', pointerEvents:'none',
});
Object.assign((mobileOverlay.querySelector('ul') as HTMLElement).style, {
  listStyle:'none', textAlign:'center', display:'flex', flexDirection:'column', gap:'0.5rem',
  padding: '0 1.25rem', width: '100%',
});
mobileOverlay.querySelectorAll('a').forEach(a =>
  Object.assign((a as HTMLElement).style, {
    fontFamily:'var(--font-serif)', fontSize:'clamp(2rem,9vw,3.5rem)', color:'var(--color-cream)',
    textDecoration:'none', fontStyle:'italic', fontWeight:'300', display:'block', padding:'0.6rem 0',
    WebkitTapHighlightColor:'transparent',
  })
);
document.body.appendChild(mobileOverlay);

const spans  = navToggle ? ([...navToggle.querySelectorAll('[data-nav="bar"]')] as HTMLElement[]) : [];
const menuTl = gsap.timeline({ paused: true, defaults: { duration: 0.38, ease: 'power2.inOut' } })
  .to(mobileOverlay, { opacity: 1, pointerEvents: 'all', duration: 0.3, ease: 'power2.out' }, 0)
  .fromTo(mobileOverlay.querySelectorAll('li'), { y: 28, opacity: 0 }, { y: 0, opacity: 1, stagger: 0.07, duration: 0.45, ease: 'power3.out' }, 0.15);

if (spans.length >= 2) {
  menuTl.to(spans[0]!, { rotation: 45,  y: 4  }, 0);
  menuTl.to(spans[1]!, { rotation: -45, y: -4 }, 0);
}

navToggle?.addEventListener('click', () => menuTl.reversed() ? menuTl.play() : menuTl.reverse());
mobileOverlay.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menuTl.reverse()));

/* ── hero ── */
gsap.timeline({ repeat: -1, repeatDelay: 0.4, delay: 3.0 })
  .to(sel('scroll-line'), { height: 40, duration: 0.55, ease: 'power2.out' })
  .to(sel('scroll-line'), { opacity: 0, duration: 0.4,  ease: 'power1.in' })
  .set(sel('scroll-line'), { height: 0, opacity: 1 });

gsap.to(sel('marquee-container'), { x: '-50%', duration: 20, ease: 'none', repeat: -1, delay: 2.8 });

const heroTl = gsap.timeline({ delay: 2.2, defaults: { ease: 'power4.out' } });
heroTl
  .to(sel('ec'),           { y: 0, opacity: 1, stagger: { each: 0.028 }, duration: 0.9 })
  .to(sel('hero-line'),    { scaleX: 1, duration: 0.7, ease: 'power2.out' }, '-=0.4')
  .to(sel('hero-title'),   { y: 0, opacity: 1, duration: 1.1 }, '-=0.5')
  .to(sel('hero-meta'),    { y: 0, opacity: 1, duration: 0.7 }, '-=0.6')
  .to(sel('hero-scroll'),  { opacity: 1, duration: 0.6, ease: 'power1.out' }, '-=0.4');

gsap.fromTo(sel('hero-video'), { scale: 1.06 }, { scale: 1, duration: 2.4, ease: 'power2.out', delay: 0.1 });

/* hero title 3D tilt — desktop pointer only */
if (window.matchMedia('(pointer: fine)').matches) {
  const heroTitle = document.querySelector(sel('hero-title')) as HTMLElement | null;
  if (heroTitle) {
    heroTitle.addEventListener('mousemove', (e: MouseEvent) => {
      const { left, top, width, height } = heroTitle.getBoundingClientRect();
      gsap.to(heroTitle, {
        rotationX: ((e.clientY - top)  / height - 0.5) * -6,
        rotationY: ((e.clientX - left) / width  - 0.5) *  8,
        transformPerspective: 800, duration: 0.4, ease: 'power2.out',
      });
    });
    heroTitle.addEventListener('mouseleave', () =>
      gsap.to(heroTitle, { rotationX: 0, rotationY: 0, duration: 0.6, ease: 'elastic.out(1,0.5)' })
    );
  }
}

gsap.to(sel('hero-meta'),  { letterSpacing: '0.28em', ease: 'none', scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 1.5 } });
gsap.to(sel('hero-video'), { yPercent: 18,            ease: 'none', scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: true } });

/* ── intro ── */
gsap.to(sel('intro-text'),    { x: 0, opacity: 1, ease: 'power2.out', duration: 1.0, scrollTrigger: { trigger: sel('intro-text'), start: 'top 80%', toggleActions: 'play none none none' } });
gsap.to(sel('intro-right-p'), { y: 0, opacity: 1, stagger: 0.14, duration: 0.9, scrollTrigger: { trigger: sel('intro-right-p'), start: 'top 82%', toggleActions: 'play none none none' } });

/* ── mobile-only scroll animations ── */
if (window.innerWidth <= 768) {
  /* about image fade on mobile */
  gsap.fromTo('#about .aspect-video', { opacity: 0, y: 30 }, {
    opacity: 1, y: 0, duration: 0.9, ease: 'power3.out',
    scrollTrigger: { trigger: '#about', start: 'top 80%', toggleActions: 'play none none none' },
  });

  /* mobile gallery panels fade in as they appear */
  gsap.fromTo('#gallery .border-b img', { opacity: 0, scale: 1.05 }, {
    opacity: 1, scale: 1, duration: 0.7, stagger: 0.12, ease: 'power2.out',
    scrollTrigger: { trigger: '#gallery', start: 'top 85%', toggleActions: 'play none none none' },
  });

  /* quote section — slide up on mobile */
  gsap.fromTo(sel('quote-text'), { y: 40, opacity: 0 }, {
    y: 0, opacity: 1, duration: 0.9, ease: 'power3.out',
    scrollTrigger: { trigger: sel('quote-text'), start: 'top 82%', toggleActions: 'play none none none' },
  });

  /* amenities section header fade */
  gsap.fromTo(sel('amenities-number'), { y: 20, opacity: 0 }, {
    y: 0, opacity: 1, duration: 0.8, ease: 'power3.out',
    scrollTrigger: { trigger: sel('amenities-number'), start: 'top 88%', toggleActions: 'play none none none' },
  });
}

/* ── about ── */
gsap.to(sel('about-image-wrapper'), { opacity: 1, x: 0, duration: 1.1, scrollTrigger: { trigger: '#about', start: 'top 72%', toggleActions: 'play none none none' } });
gsap.fromTo(`${sel('about-image-wrapper')} img`, { scale: 1.08 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: '#about', start: 'top bottom', end: 'bottom top', scrub: 2 } });
gsap.to(sel('about-sidebar'), { opacity: 1, duration: 1.4, scrollTrigger: { trigger: '#about', start: 'top 80%', toggleActions: 'play none none none' } });
gsap.to(sel('about-sidebar'), { y: -30, ease: 'none', scrollTrigger: { trigger: '#about', start: 'top bottom', end: 'bottom top', scrub: 2 } });
gsap.to(sel('about-text-p'),  { y: 0, opacity: 1, duration: 0.95, scrollTrigger: { trigger: sel('about-text-p'), start: 'top 78%', toggleActions: 'play none none none' } });
gsap.to(sel('about-stats'),   { y: 0, opacity: 1, stagger: 0.12, duration: 0.8, scrollTrigger: { trigger: sel('about-stats'), start: 'top 82%', toggleActions: 'play none none none' } });
gsap.to(sel('stat-label'), { y: 0, opacity: 1, stagger: 0.15, duration: 0.6, delay: 0.3, scrollTrigger: { trigger: sel('about-stats'), start: 'top 82%', toggleActions: 'play none none none' } });

/* stat number scale — desktop pointer only */
if (window.matchMedia('(pointer: fine)').matches) {
  document.querySelectorAll(sel('stat-number')).forEach(el => {
    el.addEventListener('mouseenter', () => gsap.to(el, { scale: 1.08, duration: 0.25, ease: 'power2.out' }));
    el.addEventListener('mouseleave', () => gsap.to(el, { scale: 1,    duration: 0.35, ease: 'elastic.out(1,0.5)' }));
  });
}

/* ── amenities ── */
gsap.to(sel('amenities-number'), { opacity: 1, y: 0, duration: 1.0, scrollTrigger: { trigger: sel('amenities-number'), start: 'top 80%', toggleActions: 'play none none none' } });
gsap.to(sel('amenities-number'), { y: -50, ease: 'none', scrollTrigger: { trigger: sel('amenities-number'), start: 'top bottom', end: 'bottom top', scrub: 1.5 } });
gsap.to(sel('amenity-row'),      { x: 0, opacity: 1, stagger: 0.08, duration: 0.75, scrollTrigger: { trigger: sel('amenity-row'), start: 'top 78%', toggleActions: 'play none none none' } });

/* amenity row hover — desktop pointer only */
if (window.matchMedia('(pointer: fine)').matches) {
  document.querySelectorAll(sel('amenity-row')).forEach(row => {
    const name    = row.querySelector(sel('amenity-name'))    as HTMLElement | null;
    const counter = row.querySelector(sel('amenity-counter')) as HTMLElement | null;
    row.addEventListener('mouseenter', () => {
      if (name)    gsap.to(name,    { x: 8, color: 'var(--color-terracotta)', duration: 0.25, ease: 'power2.out' });
      if (counter) gsap.to(counter, { scale: 1.3, duration: 0.25, ease: 'back.out(2)' });
    });
    row.addEventListener('mouseleave', () => {
      if (name)    gsap.to(name,    { x: 0, color: 'var(--color-charcoal)', duration: 0.3 });
      if (counter) gsap.to(counter, { scale: 1, duration: 0.3 });
    });
  });
}

/* ── gallery ── */
gsap.to(sel('gallery-label'),   { opacity: 1, x: 0, duration: 0.7, scrollTrigger: { trigger: '#gallery', start: 'top 90%', toggleActions: 'play none none none' } });
gsap.to(sel('gallery-caption'), { y: 0, opacity: 1, stagger: 0.1, duration: 0.8, scrollTrigger: { trigger: '#gallery', start: 'top 85%', toggleActions: 'play none none none' } });

/* gallery panel image zoom — desktop pointer only */
if (window.matchMedia('(pointer: fine)').matches) {
  document.querySelectorAll(sel('gallery-panel')).forEach(panel => {
    const img = panel.querySelector('img') as HTMLElement | null;
    if (!img) return;
    panel.addEventListener('mouseenter', () => gsap.to(img, { scale: 1.04, duration: 0.6, ease: 'power2.out' }));
    panel.addEventListener('mouseleave', () => gsap.to(img, { scale: 1,    duration: 0.7, ease: 'power2.out' }));
  });
}

const scrollHint    = document.querySelector(sel('gallery-scroll-hint'));
const scrollHintSvg = scrollHint?.querySelector('svg');
if (scrollHint && scrollHintSvg) {
  gsap.to(scrollHintSvg, { x: 6, duration: 0.65, ease: 'power1.inOut', yoyo: true, repeat: -1 });
  gsap.to(scrollHint,    { opacity: 0, duration: 0.6, ease: 'power2.in', delay: 3 });
}

/* ── gallery pin ── */
const track   = document.querySelector(sel('gallery-track'));
const panels  = gsap.utils.toArray(sel('gallery-panel'));
const counter = document.querySelector(sel('gallery-counter'));

if (track && panels.length && window.innerWidth > 768) {
  ScrollTrigger.refresh();
  const totalWidth = (track as HTMLElement).scrollWidth - window.innerWidth;
  gsap.to(track, {
    x: () => -totalWidth,
    ease: 'none',
    scrollTrigger: {
      trigger: '#gallery',
      start: 'top top',
      end: () => `+=${totalWidth}`,
      scrub: 1.0, pin: true, anticipatePin: 1, invalidateOnRefresh: true,
      onUpdate: self => {
        if (counter) {
          const idx = Math.min(Math.round(self.progress * (panels.length - 1)), panels.length - 1);
          counter.textContent = `${String(idx + 1).padStart(2, '0')} / ${String(panels.length).padStart(2, '0')}`;
        }
      },
    },
  });
}

/* ── quote ── */
gsap.fromTo(sel('quote-bg-img'), { scale: 1.08 }, { scale: 1, ease: 'none', scrollTrigger: { trigger: sel('quote-bg-img'), start: 'top bottom', end: 'center center', scrub: 1.5 } });
gsap.to(sel('quote-bg-img'),     { yPercent: 12, ease: 'none', scrollTrigger: { trigger: sel('quote-bg-img'), start: 'top bottom', end: 'bottom top', scrub: true } });
gsap.to([sel('quote-text'), sel('quote-attribution')], { y: 0, opacity: 1, stagger: 0.18, duration: 1.0, scrollTrigger: { trigger: sel('quote-text'), start: 'top 72%', toggleActions: 'play none none none' } });
gsap.to(sel('quote-stat'),       { y: 0, opacity: 1, stagger: 0.14, duration: 0.85, scrollTrigger: { trigger: sel('quote-stat'), start: 'top 78%', toggleActions: 'play none none none' } });
gsap.to(sel('quote-stat-sep'),   { scaleX: 1, stagger: 0.18, duration: 0.55, ease: 'power2.out', scrollTrigger: { trigger: sel('quote-stat'), start: 'top 78%', toggleActions: 'play none none none' } });
gsap.to(sel('quote-stat-label'), { y: 0, opacity: 1, stagger: 0.14, duration: 0.5, scrollTrigger: { trigger: sel('quote-stat'), start: 'top 78%', toggleActions: 'play none none none' } });

document.querySelectorAll(sel('quote-stat-number')).forEach(el => {
  const target = parseFloat(el.textContent ?? '0');
  const obj    = { val: 0 };
  ScrollTrigger.create({
    trigger: el, start: 'top 82%', once: true,
    onEnter: () => gsap.to(obj, { val: target, duration: 2.0, ease: 'power2.out', onUpdate: () => { el.textContent = String(Math.round(obj.val)); } }),
  });
});

/* ── location ── */
gsap.to(`${sel('location-image')} img`, { yPercent: 8, ease: 'none', scrollTrigger: { trigger: sel('location-image'), start: 'top bottom', end: 'bottom top', scrub: true } });

ScrollTrigger.create({
  trigger: '#location', start: 'top 78%', once: true,
  onEnter: () => gsap.timeline({ defaults: { ease: 'power3.out' } })
    .to(sel('location-address'),  { y: 0, opacity: 1, duration: 1.0 })
    .to(sel('location-city'),     { y: 0, opacity: 1, duration: 0.6 }, '-=0.5')
    .to(sel('location-desc'),     { y: 0, opacity: 1, duration: 0.8 }, '-=0.4')
    .to(sel('location-distance'), { x: 0, opacity: 1, stagger: 0.1, duration: 0.6 }, '-=0.5')
    .to(sel('location-miles'),    { x: 0, opacity: 1, stagger: 0.1, duration: 0.5 }, '-=0.5'),
});

/* location distance hover — desktop pointer only */
if (window.matchMedia('(pointer: fine)').matches) {
  document.querySelectorAll(sel('location-distance')).forEach(row => {
    const miles = row.querySelector(sel('location-miles')) as HTMLElement | null;
    row.addEventListener('mouseenter', () => {
      if (miles) gsap.to(miles, { scale: 1.1, duration: 0.2, ease: 'back.out(2)' });
    });
    row.addEventListener('mouseleave', () => {
      if (miles) gsap.to(miles, { scale: 1, duration: 0.25 });
    });
  });
}

/* ── enquire ── */
ScrollTrigger.create({
  trigger: '#enquire', start: 'top 65%', once: true,
  onEnter: () => gsap.timeline({ defaults: { ease: 'power3.out' } })
    .to(sel('enquire-title'),   { y: 0, opacity: 1, duration: 1.1 })
    .to(sel('enquire-rule'),    { scaleX: 1, duration: 0.6, ease: 'power2.out' }, '-=0.5')
    .to(sel('enquire-eyebrow'), { y: 0, opacity: 1, duration: 0.7 }, '-=0.3')
    .to(sel('enquire-contact'), { y: 0, opacity: 1, duration: 0.7 }, '-=0.4')
    .to(sel('enquire-right'),   { y: 0, opacity: 1, duration: 0.8 }, '-=0.5')
    .to(sel('enquire-social'),  { y: 0, opacity: 1, duration: 0.6 }, '-=0.4')
    .to(sel('form-group'),   { y: 0, opacity: 1, stagger: 0.1, duration: 0.55 }, '-=0.3')
    .to(sel('form-submit'),     { y: 0, opacity: 1, duration: 0.45 }, '-=0.2'),
});

/* submit + enquire link hover — desktop pointer only */
if (window.matchMedia('(pointer: fine)').matches) {
  const submitBtn = document.querySelector(sel('form-submit')) as HTMLElement | null;
  if (submitBtn) {
    const arrow = submitBtn.querySelector('svg') as HTMLElement | null;
    submitBtn.addEventListener('mouseenter', () => {
      if (arrow) gsap.to(arrow, { x: 5, duration: 0.25, ease: 'power2.out' });
      gsap.to(submitBtn, { letterSpacing: '0.2em', duration: 0.3 });
    });
    submitBtn.addEventListener('mouseleave', () => {
      if (arrow) gsap.to(arrow, { x: 0, duration: 0.3, ease: 'elastic.out(1,0.5)' });
      gsap.to(submitBtn, { letterSpacing: '0.14em', duration: 0.3 });
    });
  }

  document.querySelectorAll(sel('enquire-link')).forEach(link => {
    link.addEventListener('mouseenter', () => gsap.to(link, { x: 6, duration: 0.2, ease: 'power2.out' }));
    link.addEventListener('mouseleave', () => gsap.to(link, { x: 0, duration: 0.3, ease: 'elastic.out(1,0.5)' }));
  });
}

/* ── footer ── */
gsap.timeline({
  scrollTrigger: { trigger: sel('footer-logo'), start: 'top 95%', toggleActions: 'play none none none' },
})
  .to(sel('footer-logo'), { y: 0, opacity: 1, duration: 0.6 })
  .to(sel('footer-copy'), { y: 0, opacity: 1, duration: 0.5 }, '-=0.3');

/* ─────────────────────────────────────────
   FORM SUBMISSION — success state
─────────────────────────────────────── */
const form = document.querySelector('.enquire-form');
form?.addEventListener('submit', e => {
  e.preventDefault();
  gsap.to(form, {
    opacity: 0, y: -16, duration: 0.45, ease: 'power2.in',
    onComplete: () => {
      form.innerHTML = '<p class="form-success">Thank you. We\'ll be in touch.</p>';
      gsap.fromTo(form, { opacity: 0, y: 16 }, { opacity: 1, y: 0, duration: 0.55, ease: 'power2.out' });
    },
  });
});

/* ── load screen — fades at t=1.8, heroTl starts at t=2.2 for clean overlap ── */
const loadScreen = document.getElementById('load-screen');
if (loadScreen) {
  document.body.style.overflow = 'hidden';
  gsap.timeline({
    onComplete: () => {
      loadScreen.style.display = 'none';
      document.body.style.overflow = '';
    }
  })
    .to('.ls-logo',  { y: 0, opacity: 1, duration: 0.9, ease: 'power3.out' }, 0.2)
    .to('.ls-line',  { width: 60, duration: 0.6, ease: 'power2.out' }, 0.75)
    .to('.ls-sub',   { opacity: 1, duration: 0.5, ease: 'power2.out' }, 1.0)
    .to(loadScreen,  { opacity: 0, duration: 0.7, ease: 'power2.inOut' }, 1.8);
} else {
  // No load screen (e.g. dev HMR) — fire hero immediately
  heroTl.delay(0.15);
}

/* ── lightbox ── */
const lightbox      = document.getElementById('lightbox');
const lightboxImg   = document.getElementById('lightbox-img') as HTMLImageElement | null;
const lightboxCap   = document.getElementById('lightbox-caption');
const lightboxClose = document.getElementById('lightbox-close');

const openLightbox = (src: string, alt: string, caption: string) => {
  if (!lightbox || !lightboxImg || !lightboxCap || !lightboxClose) return;
  lightboxImg.src = src;
  lightboxImg.alt = alt;
  lightboxCap.textContent = caption;
  lightbox.classList.add('open');
  gsap.fromTo(lightbox,    { opacity: 0 }, { opacity: 1, duration: 0.4, ease: 'power2.out' });
  gsap.fromTo(lightboxImg, { scale: 0.92 }, { scale: 1, duration: 0.5, ease: 'power3.out' });
  document.body.style.overflow = 'hidden';
  (lightboxClose as HTMLElement).focus();
};

const closeLightbox = () => {
  if (!lightbox || !lightboxImg) return;
  gsap.to(lightbox, {
    opacity: 0, duration: 0.3, ease: 'power2.in',
    onComplete: () => { lightbox.classList.remove('open'); lightboxImg.src = ''; document.body.style.overflow = ''; },
  });
};

document.querySelectorAll(sel('gallery-panel')).forEach(panel => {
  panel.addEventListener('click', () => {
    const img = panel.querySelector('img');
    if (img) openLightbox(img.src, img.alt, (panel.querySelector(sel('panel-title')) as HTMLElement)?.textContent?.trim() ?? '');
  });
});

lightboxClose?.addEventListener('click', closeLightbox);
lightbox?.addEventListener('click', e => { if (e.target === lightbox) closeLightbox(); });
document.addEventListener('keydown', e => { if (e.key === 'Escape' && lightbox?.classList.contains('open')) closeLightbox(); });

/* ── back to top ── */
const backToTop = document.getElementById('back-to-top');
if (backToTop) {
  const showBtn = () => { backToTop.style.pointerEvents = 'all';  gsap.to(backToTop, { opacity: 1, duration: 0.4, ease: 'power2.out' }); };
  const hideBtn = () => { backToTop.style.pointerEvents = 'none'; gsap.to(backToTop, { opacity: 0, duration: 0.3, ease: 'power2.in' }); };
  ScrollTrigger.create({ trigger: '.hero', start: 'bottom top', onEnter: showBtn, onLeaveBack: hideBtn });
  backToTop.addEventListener('click', () => gsap.to(window, { scrollTo: 0, duration: 1.2, ease: 'power3.inOut' }));
}

/* ── logo scroll to top ── */
document.querySelector('[data-nav="logo"]')?.addEventListener('click', e => {
  e.preventDefault();
  gsap.to(window, { scrollTo: 0, duration: 1.2, ease: 'power3.inOut' });
});

/* ── active nav ── */
const navLinks = document.querySelectorAll('[data-nav="link"]');
const setActive = (id: string) => {
  navLinks.forEach(link => { link.removeAttribute('aria-current'); link.classList.remove('active'); });
  const active = document.querySelector(`[data-nav="link"][href="#${id}"]`);
  active?.setAttribute('aria-current', 'page');
  active?.classList.add('active');
};

document.querySelectorAll('section[id]').forEach(section => {
  ScrollTrigger.create({
    trigger: section, start: 'top 55%', end: 'bottom 55%',
    onEnter: () => setActive(section.id),
    onEnterBack: () => setActive(section.id),
  });
});

/* ── reduced motion ── */
if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  gsap.globalTimeline.timeScale(0);
  gsap.set([
    sel('ec'), sel('hero-line'), sel('hero-title'), sel('hero-meta'), sel('hero-scroll'),
    sel('scroll-line'), sel('marquee-container'), sel('hero-video'), sel('nav-logo'), '[data-nav="link"]',
    sel('intro-text'), sel('intro-right-p'), sel('about-image-wrapper'),
    sel('about-sidebar'), sel('about-text-p'), sel('about-stats'), sel('stat-label'),
    sel('amenities-number'), sel('amenity-row'), sel('gallery-label'), sel('gallery-caption'),
    sel('gallery-scroll-hint'), sel('quote-text'), sel('quote-attribution'), sel('quote-stat'),
    sel('quote-stat-sep'), sel('quote-stat-label'), sel('location-address'), sel('location-city'),
    sel('location-desc'), sel('location-distance'), sel('location-miles'), sel('enquire-title'),
    sel('enquire-rule'), sel('enquire-eyebrow'), sel('enquire-contact'), sel('enquire-right'),
    sel('enquire-social'), sel('form-group'), sel('form-submit'), sel('footer-logo'), sel('footer-copy'),
    '#load-screen',
  ], { clearProps: 'all' });
  if (loadScreen) loadScreen.style.display = 'none';
  document.body.style.overflow = '';
}
</script>
