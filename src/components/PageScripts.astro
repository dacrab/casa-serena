<script>
import { gsap, sel } from '../lib/gsap';

/* ── load screen ── */
const loadScreen = document.getElementById('load-screen');
if (loadScreen) {
  document.body.style.overflow = 'hidden';
  gsap.timeline({
    onComplete: () => {
      loadScreen.style.display = 'none';
      document.body.style.overflow = '';
      document.dispatchEvent(new CustomEvent('casa:loaded'));
    },
  })
    .to('.ls-logo', { y: 0, opacity: 1, duration: 1.0, ease: 'power3.out' }, 0.2)
    .to('.ls-line', { width: 60, duration: 0.7, ease: 'power2.out' }, 0.85)
    .to('.ls-sub',  { opacity: 1, duration: 0.6, ease: 'power2.out' }, 1.1)
    .to(loadScreen, { opacity: 0, duration: 0.8, ease: 'power2.inOut' }, 2.0);
} else {
  document.dispatchEvent(new CustomEvent('casa:loaded'));
}

/* ── reduced motion ── */
if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
  gsap.globalTimeline.timeScale(0);
  gsap.set([
    sel('ec'), sel('hero-line'), sel('hero-title'), sel('hero-meta'), sel('hero-scroll'),
    sel('scroll-line'), sel('marquee-container'), sel('nav-logo'), '[data-nav="link"]',
    sel('intro-text'), sel('intro-right-p'), sel('about-image-wrapper'),
    sel('about-sidebar'), sel('about-text-p'), sel('about-stats'), sel('stat-label'),
    sel('amenities-number'), sel('amenity-row'), sel('gallery-label'), sel('gallery-caption'),
    sel('gallery-scroll-hint'), sel('gallery-panel'), sel('quote-bg-img'),
    sel('quote-text'), sel('quote-attribution'), sel('quote-stat'),
    sel('quote-stat-sep'), sel('quote-stat-label'), sel('location-address'), sel('location-city'),
    sel('location-desc'), sel('location-distance'), sel('location-miles'), sel('enquire-title'),
    sel('enquire-rule'), sel('enquire-eyebrow'), sel('enquire-contact'), sel('enquire-right'),
    sel('enquire-social'), sel('form-group'), sel('form-submit'),
    '#about .aspect-video', '#load-screen',
  ], { clearProps: 'all' });
  if (loadScreen) loadScreen.style.display = 'none';
  document.body.style.overflow = '';
}
</script>
