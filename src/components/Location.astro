---
const distances = [
  { name: 'Fira',              km: '12 km' },
  { name: 'Santorini Airport', km: '8 km' },
  { name: 'Heraklion, Crete',  km: '130 km' },
  { name: 'Athens',            km: '280 km' },
];
---

<section id="location" data-nav-theme="light" class="bg-warm-white">
  <div id="map" class="w-full h-[40vh] md:h-[50vh]"></div>

  <div data-anim="content" class="grid md:grid-cols-2 gap-8 md:gap-10 section-px py-10 md:py-[10vh]">
    <div>
      <h2 data-anim="text" class="font-serif font-light text-charcoal mb-2 heading-md">Oia, Santorini 847 02</h2>
      <p data-anim="text" class="text-driftwood mb-4">Santorini, Greece</p>
      <p data-anim="text" class="text-charcoal leading-relaxed">
        Perched on the caldera cliffs of Oia with unobstructed views of the Aegean.
        Isolated enough to feel like a retreat, close enough to reach Fira and beyond.
      </p>
    </div>
    <dl>
      {distances.map(({ name, km }) => (
        <div data-anim="distance" class="flex justify-between py-4 border-t border-driftwood/20">
          <dt class="font-medium text-charcoal">{name}</dt>
          <dd class="text-terracotta font-medium">{km}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script>
  import L from 'leaflet';

  const map = L.map('map', { scrollWheelZoom: false, zoomControl: false, attributionControl: false }).setView([36.4618, 25.3753], 16);

  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
    maxZoom: 19,
  }).addTo(map);

  // Custom terracotta pin
  const pin = L.divIcon({
    className: '',
    html: `<svg width="36" height="48" viewBox="0 0 36 48" fill="none"><path d="M18 0C8.06 0 0 8.06 0 18c0 13.5 18 30 18 30S36 31.5 36 18C36 8.06 27.94 0 18 0z" fill="#C4714A"/><circle cx="18" cy="18" r="7" fill="#FDFAF5"/></svg>`,
    iconSize: [36, 48],
    iconAnchor: [18, 48],
  });

  L.marker([36.4618, 25.3753], { icon: pin }).addTo(map);

  // Re-add minimal attribution
  L.control.attribution({ position: 'bottomright', prefix: false })
    .addAttribution('© <a href="https://carto.com">CARTO</a>')
    .addTo(map);
</script>
