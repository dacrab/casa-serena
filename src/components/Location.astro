---
import { site } from '../lib/site';

const distances = [
  { name: 'Fira',             km: '12 km' },
  { name: 'Santorini Airport', km: '8 km' },
  { name: 'Heraklion, Crete', km: '130 km' },
  { name: 'Athens',           km: '280 km' },
];

const mapLabel = `Map showing ${site.address.name}, ${site.address.street}, ${site.addressLine}`;
---

<section id="location" class="bg-warm-white">
  <div class="grid md:grid-cols-2 min-h-[50vh]">
    <div id="map" role="region" aria-label={mapLabel} class="w-full h-[50vw] md:h-auto min-h-[300px]">
      <p data-map-fallback class="sr-only">
        {site.address.name}<br />{site.address.street}<br />{site.addressLine}
      </p>
      <noscript>
        <p class="h-full flex items-center justify-center p-8 text-center text-sm text-charcoal/60">
          {site.address.name}<br />{site.address.street}<br />{site.addressLine}
        </p>
      </noscript>
    </div>
    <div data-reveal class="section-px py-10 md:py-16 flex items-center">
      <dl class="w-full">
        {distances.map(({ name, km }) => (
          <div data-reveal="x" class="flex justify-between py-4 border-t border-driftwood/20">
            <dt class="font-medium text-charcoal">{name}</dt>
            <dd class="text-terracotta font-medium">{km}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<script>
  import '../scripts/location';
</script>
