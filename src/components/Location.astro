---
import { Image } from 'astro:assets';
---
<script>
import { gsap } from '../lib/gsap';
gsap.from('#location h2, #location p', { opacity: 0, y: 20, stagger: 0.1, duration: 0.8, scrollTrigger: { trigger: '#location', start: 'top 80%' } });
gsap.from('.distance', { opacity: 0, x: 20, stagger: 0.1, duration: 0.6, scrollTrigger: { trigger: '.distance', start: 'top 85%' } });
</script>

<section id="location" data-nav-theme="light" class="bg-warm-white">
  <div class="w-full h-[40vh] overflow-hidden">
    <Image src="/images/location.jpg" alt="Santorini caldera aerial view" width={1400} height={788} format="webp" quality={85} loading="lazy" class="w-full h-full object-cover" />
  </div>
  <div class="grid md:grid-cols-2 gap-10 section-px py-[10vh]">
    <div>
      <h2 class="font-serif font-light text-charcoal text-4xl mb-2">Oia, Santorini 847 02</h2>
      <p class="text-driftwood mb-4">Santorini, Greece</p>
      <p class="text-charcoal leading-relaxed">Perched on the caldera cliffs of Oia with unobstructed views of the Aegean. Isolated enough to feel like a retreat, close enough to reach Fira and beyond.</p>
    </div>
    <dl class="space-y-4">
      <div class="distance flex justify-between py-4 border-t border-driftwood/20">
        <dt class="font-medium text-charcoal">Fira</dt>
        <dd class="text-terracotta font-medium">12 km</dd>
      </div>
      <div class="distance flex justify-between py-4 border-t border-driftwood/20">
        <dt class="font-medium text-charcoal">Santorini Airport</dt>
        <dd class="text-terracotta font-medium">8 km</dd>
      </div>
      <div class="distance flex justify-between py-4 border-t border-driftwood/20">
        <dt class="font-medium text-charcoal">Heraklion, Crete</dt>
        <dd class="text-terracotta font-medium">130 km</dd>
      </div>
      <div class="distance flex justify-between py-4 border-t border-driftwood/20">
        <dt class="font-medium text-charcoal">Athens</dt>
        <dd class="text-terracotta font-medium">280 km</dd>
      </div>
    </dl>
  </div>
</section>

