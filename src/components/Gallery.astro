---
import { Image } from 'astro:assets';
import gallery1 from '../assets/images/gallery-1.webp';
import quote    from '../assets/images/quote.webp';
import gallery2 from '../assets/images/gallery-2.webp';
import gallery3 from '../assets/images/gallery-3.webp';
import gallery4 from '../assets/images/gallery-4.webp';
import gallery5 from '../assets/images/gallery-5.webp';

const [hero, ...rest] = [
  { src: gallery1, alt: 'Casa Serena exterior at golden hour' },
  { src: quote,    alt: 'Casa Serena pool at sunset' },
  { src: gallery2, alt: 'Casa Serena beachfront pool' },
  { src: gallery3, alt: 'Casa Serena wide exterior view' },
  { src: gallery4, alt: 'Casa Serena chef kitchen' },
  { src: gallery5, alt: 'Casa Serena master suite bedroom' },
];
---

<section
  id="gallery"
  data-nav-theme="dark"
  class="bg-gallery-bg py-10 md:py-[8vh] section-px"
>
  <p class="label-xs text-cream/40 mb-6 md:mb-8">The Property</p>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
    <div data-anim="hero" class="sm:col-span-2 md:col-span-2 aspect-[16/9] overflow-hidden">
      <Image src={hero!.src} alt={hero!.alt} loading="lazy" class="w-full h-full object-cover gallery-img" />
    </div>
    {rest.map(({ src, alt }, i) => (
      <div
        data-anim="cell"
        class:list={[
          'overflow-hidden',
          i === 0 ? 'aspect-[4/3] sm:aspect-[3/4]' : 'aspect-[4/3]',
        ]}
      >
        <Image src={src} alt={alt} loading="lazy" class="w-full h-full object-cover gallery-img" />
      </div>
    ))}
  </div>
</section>
