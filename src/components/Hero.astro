<script>
import { gsap } from '../lib/gsap';

gsap.from('#hero h1, #hero p', { opacity: 0, y: 30, stagger: 0.15, duration: 1, delay: 0.3 });
gsap.to('.marquee', { x: '-50%', duration: 20, ease: 'none', repeat: -1 });

document.querySelector('video')?.play().catch(() => {});
</script>

<section id="hero" data-nav-theme="dark" class="relative h-screen flex items-end">
  <video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover -z-20" aria-hidden="true">
    <source src="/images/hero.mp4" type="video/mp4; codecs=hvc1" />
    <source src="/images/hero-h264.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-black/10 to-black/60 -z-10"></div>
  
  <div class="section-px pb-8 md:pb-12">
    <p class="label-xs text-cream mb-6">BEACHFRONT ESTATE</p>
    <h1 class="font-serif italic font-light text-cream text-8xl md:text-[14rem] leading-none mb-4">Serena</h1>
    <p class="label-xs text-cream/70">Santorini, Greece · 4 Suites · 8 Acres · Caldera View</p>
  </div>
</section>

<div class="h-10 bg-terracotta overflow-hidden" aria-hidden="true">
  <div class="marquee flex whitespace-nowrap">
    <span class="label-xs text-cream pr-12">PRIVATE ESTATE · SANTORINI GREECE · CALDERA VIEW · 4 SUITES · INFINITY POOL · </span>
    <span class="label-xs text-cream pr-12">PRIVATE ESTATE · SANTORINI GREECE · CALDERA VIEW · 4 SUITES · INFINITY POOL · </span>
  </div>
</div>

