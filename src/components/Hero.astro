---
---
<section id="hero" class="relative h-svh overflow-hidden">
  <!-- Video -->
  <div class="absolute inset-0 overflow-hidden">
    <video
      data-anim="hero-video"
      class="w-full h-full object-cover"
      autoplay loop muted playsinline aria-hidden="true"
      poster="https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=1800&q=85"
    >
      <source src="https://videos.pexels.com/video-files/3045163/3045163-uhd_2560_1440_25fps.mp4" type="video/mp4" />
      <source src="https://videos.pexels.com/video-files/1093662/1093662-sd_960_540_24fps.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- Gradient overlay -->
  <div class="absolute inset-0 z-[2] pointer-events-none" style="background:radial-gradient(ellipse at bottom left,rgba(0,0,0,0.3),rgba(0,0,0,0.7))"></div>

  <!-- Hero content -->
  <div class="absolute bottom-8 left-5 right-5 z-[4] md:left-[4vw] md:right-auto md:max-w-[600px]">
    <div data-anim="hero-eyebrow" class="font-sans text-[0.65rem] tracking-[0.25em] uppercase text-cream mb-6 flex flex-wrap">
      {'BEACHFRONT ESTATE'.split('').map(c => <span data-anim="ec" class="inline-block">{c}</span>)}
    </div>
    <div data-anim="hero-line" class="w-16 h-px bg-terracotta mb-8" style="transform-origin:left"></div>
    <h1 data-anim="hero-title" class="font-serif italic font-light text-cream leading-[0.85] mb-6" style="font-size:clamp(3.5rem,13vw,14rem)">
      Serena
    </h1>
    <div data-anim="hero-meta" class="font-sans text-[0.65rem] tracking-[0.15em] uppercase" style="color:var(--cream-70)">
      Santorini, Greece · 4 Suites · 8 Acres · Caldera View
    </div>
  </div>

  <!-- Scroll indicator — desktop only -->
  <div data-anim="hero-scroll" class="hidden md:flex absolute bottom-[4vw] right-[4vw] z-[4] flex-col items-center gap-2">
    <div data-anim="scroll-line" class="w-px bg-terracotta" style="height:0"></div>
    <div class="font-sans text-[0.65rem] tracking-[0.15em] uppercase text-cream [writing-mode:vertical-rl] rotate-180">SCROLL</div>
  </div>
</section>

<!-- Marquee -->
<div class="w-full h-10 bg-terracotta overflow-x-hidden flex items-center">
  <div data-anim="marquee-container" class="flex whitespace-nowrap will-change-transform shrink-0">
    <span class="font-sans text-[0.7rem] tracking-[0.2em] uppercase text-cream pr-12">PRIVATE ESTATE · SANTORINI GREECE · CALDERA VIEW · 4 SUITES · INFINITY POOL · </span>
    <span class="font-sans text-[0.7rem] tracking-[0.2em] uppercase text-cream pr-12">PRIVATE ESTATE · SANTORINI GREECE · CALDERA VIEW · 4 SUITES · INFINITY POOL · </span>
  </div>
</div>

<!-- Intro -->
<section class="bg-warm-white py-[12vh] px-5 md:px-[4vw] grid grid-cols-1 md:grid-cols-[7fr_3fr] gap-8 md:gap-[4vw] items-center overflow-hidden">
  <h2 data-anim="intro-text" class="font-serif italic font-light text-charcoal leading-[1.1]" style="font-size:clamp(2.2rem,8vw,8rem)">
    A house that breathes.
  </h2>
  <div class="flex flex-col gap-4 pl-5 md:pl-8 border-l border-terracotta">
    <p data-anim="intro-right-p" class="font-sans text-[0.9rem] md:text-[0.95rem] text-driftwood leading-[1.7]">
      Designed to dissolve boundaries between interior and ocean, Casa Serena is where architecture whispers rather than shouts. Light becomes material here.
    </p>
  </div>
</section>
