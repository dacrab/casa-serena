---
import heroPoster from '../assets/images/hero-poster.webp';

const stats = [
  { value: '04', label: 'Suites' },
  { value: '08', label: 'Acres' },
  { value: '180°', label: 'Caldera' },
  { value: '01', label: 'Private beach' },
];
---

<section id="hero" data-hero class="relative flex min-h-svh flex-col overflow-hidden bg-ink text-paper">
  <video
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    poster={heroPoster.src}
    class="absolute inset-0 h-full w-full object-cover"
    aria-hidden="true"
  >
    <source src="/images/hero.mp4" type="video/mp4" />
  </video>
  <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/10 to-ink/90"></div>
  <div class="absolute inset-0 bg-gradient-to-r from-ink/45 via-ink/5 to-ink/40"></div>
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_40%,transparent_30%,rgba(28,43,44,0.4)_100%)]"></div>

  <div class="shell relative z-10 flex min-h-svh flex-col justify-between pt-28 pb-8 md:pb-10">
    <div class="flex items-start justify-between gap-4 hero-fade">
      <p class="label text-paper/65">A private estate · Oia, Santorini</p>
      <p class="label hidden text-paper/50 sm:block">Est. 1987</p>
    </div>

    <div class="grid gap-8 md:grid-cols-12 md:items-end">
      <div class="md:col-span-8">
        <p class="label mb-5 text-paper/60 hero-fade">Caldera · Aegean</p>
        <h1 class="display-xl">
          <span class="hero-line"><span>Casa</span></span>
          <span class="hero-line"><span><em>Serena</em></span></span>
        </h1>
      </div>

      <div class="md:col-span-4 md:pb-2 hero-fade">
        <p class="body-lg max-w-sm text-paper/80">
          Four suites suspended between the caldera and the Aegean. A house made for slow days and long evenings.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-5">
          <a href="/suites" class="btn btn-light">Explore the suites</a>
          <a href="/enquire" class="link-line text-paper">Enquire</a>
        </div>
      </div>
    </div>

    <div class="mt-12 flex items-end justify-between gap-6 border-t border-paper/25 pt-5 hero-fade">
      <dl class="flex flex-wrap gap-x-8 gap-y-3">
        {stats.map(({ value, label }) => (
          <div class="flex items-baseline gap-2">
            <dt class="label text-paper/45">{label}</dt>
            <dd class="font-serif text-lg leading-none text-paper/85">{value}</dd>
          </div>
        ))}
      </dl>
      <a href="#intro" class="label hidden items-center gap-3 text-paper/55 transition-colors hover:text-paper sm:flex">
        Scroll
        <span class="relative block h-10 w-px overflow-hidden bg-paper/25">
          <span class="scroll-dash absolute inset-x-0 top-0 block h-4 bg-paper"></span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  #hero video {
    opacity: 0;
    animation: hero-fade 1.4s ease 0.2s forwards;
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
    margin-bottom: -0.04em;
  }

  .hero-line > span {
    display: block;
    transform: translateY(112%);
    animation: hero-rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-line:nth-child(1) > span {
    animation-delay: 0.35s;
  }

  .hero-line:nth-child(2) > span {
    animation-delay: 0.47s;
  }

  .hero-fade {
    opacity: 0;
    animation: hero-up 1s cubic-bezier(0.16, 1, 0.3, 1) 0.65s forwards;
  }

  .scroll-dash {
    animation: scroll-dash 2.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes hero-fade {
    to { opacity: 1; }
  }

  @keyframes hero-rise {
    to { transform: none; }
  }

  @keyframes hero-up {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes scroll-dash {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(150%); }
    100% { transform: translateY(150%); }
  }
</style>
