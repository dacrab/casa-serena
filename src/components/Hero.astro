<script>
import { gsap, ScrollTrigger, sel, isPointer, isMobile } from '../lib/gsap';

/* ── initial states ── */
gsap.set(sel('ec'),            { y: 22, opacity: 0 });
gsap.set(sel('hero-title'),    { y: 70, opacity: 0 });
gsap.set(sel('hero-scroll'),   { opacity: 0 });
gsap.set(sel('scroll-line'),   { height: 0 });
gsap.set(sel('hero-meta'),     { y: 16, opacity: 0 });
gsap.set(sel('intro-text'),    { x: 60, opacity: 0 });
gsap.set(sel('intro-right-p'), { y: 24, opacity: 0 });
gsap.set(sel('hero-line'),     { scaleX: 0, transformOrigin: 'left center' });

/* ── marquee ── */
gsap.to(sel('marquee-container'), { x: '-50%', duration: 20, ease: 'none', repeat: -1, delay: 2.8 });

/* ── scroll indicator loop ── */
gsap.timeline({ repeat: -1, repeatDelay: 0.4, delay: 3.0 })
  .to(sel('scroll-line'), { height: 40, duration: 0.55, ease: 'power2.out' })
  .to(sel('scroll-line'), { opacity: 0, duration: 0.4,  ease: 'power1.in' })
  .set(sel('scroll-line'), { height: 0, opacity: 1 });

/* ── entrance timeline ── */
const tl = gsap.timeline({ paused: true, defaults: { ease: 'power4.out' } })
  .to(sel('ec'),         { y: 0, opacity: 1, stagger: { each: 0.028 }, duration: 0.9 })
  .to(sel('hero-line'),  { scaleX: 1, duration: 0.7, ease: 'power2.out' }, '-=0.4')
  .to(sel('hero-title'), { y: 0, opacity: 1, duration: 1.1 }, '-=0.5')
  .to(sel('hero-meta'),  { y: 0, opacity: 1, duration: 0.7 }, '-=0.6')
  .to(sel('hero-scroll'),{ opacity: 1, duration: 0.6, ease: 'power1.out' }, '-=0.4');

document.addEventListener('casa:loaded', () => tl.play(), { once: true });

/* ── force video play ── */
const video = document.querySelector('#hero video') as HTMLVideoElement | null;
video?.play().catch(() => {});

/* ── 3D tilt — desktop ── */
if (isPointer) {
  const title = document.querySelector(sel('hero-title')) as HTMLElement | null;
  if (title) {
    title.addEventListener('mousemove', (e: MouseEvent) => {
      const { left, top, width, height } = title.getBoundingClientRect();
      gsap.to(title, { rotationX: ((e.clientY - top) / height - 0.5) * -6, rotationY: ((e.clientX - left) / width - 0.5) * 8, transformPerspective: 800, duration: 0.4, ease: 'power2.out' });
    });
    title.addEventListener('mouseleave', () => gsap.to(title, { rotationX: 0, rotationY: 0, duration: 0.6, ease: 'elastic.out(1,0.5)' }));
  }
}

/* ── parallax scrubs — desktop ── */
if (!isMobile) {
  gsap.to(sel('hero-meta'), { letterSpacing: '0.28em', ease: 'none', scrollTrigger: { trigger: '#hero', start: 'top top', end: 'bottom top', scrub: 1.5 } });
}

/* ── intro ── */
gsap.to(sel('intro-text'),    { x: 0, opacity: 1, duration: 1.0, ease: 'power2.out', scrollTrigger: { trigger: sel('intro-text'),    start: 'top 80%', toggleActions: 'play none none none' } });
gsap.to(sel('intro-right-p'), { y: 0, opacity: 1, stagger: 0.14, duration: 0.9,      scrollTrigger: { trigger: sel('intro-right-p'), start: 'top 82%', toggleActions: 'play none none none' } });

/* ── back to top ── */
const btn = document.getElementById('back-to-top') as HTMLElement | null;
if (btn) {
  const svg = btn.querySelector('svg') as HTMLElement | null;
  ScrollTrigger.create({
    trigger: '#hero', start: 'bottom top',
    onEnter:     () => { btn.style.pointerEvents = 'all';  gsap.to(btn, { opacity: 1, duration: 0.4, ease: 'power2.out' }); },
    onLeaveBack: () => { btn.style.pointerEvents = 'none'; gsap.to(btn, { opacity: 0, duration: 0.3, ease: 'power2.in' }); },
  });
  btn.addEventListener('click', () => gsap.to(window, { scrollTo: 0, duration: 1.2, ease: 'power3.inOut' }));
  if (isPointer) {
    btn.addEventListener('mouseenter', () => { gsap.to(btn, { backgroundColor: 'var(--color-terracotta)', borderColor: 'var(--color-terracotta)', duration: 0.25 }); if (svg) gsap.to(svg, { stroke: '#fff', duration: 0.25 }); });
    btn.addEventListener('mouseleave', () => { gsap.to(btn, { backgroundColor: 'var(--color-warm-white)', borderColor: 'var(--border-warm)', duration: 0.3 }); if (svg) gsap.to(svg, { stroke: 'var(--color-charcoal)', duration: 0.3 }); });
  }
}
</script>

<section id="hero">
  <video autoplay loop muted playsinline aria-hidden="true">
    <source src="/images/hero.mp4"      type="video/mp4; codecs=hvc1" />
    <source src="/images/hero-h264.mp4" type="video/mp4; codecs=avc1.42E01E" />
  </video>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="label-xs text-cream mb-6 flex flex-wrap" style="letter-spacing:0.25em">
      {'BEACHFRONT ESTATE'.split('').map(c => <span data-anim="ec" class="inline-block">{c}</span>)}
    </div>
    <div data-anim="hero-line" class="w-16 h-px bg-terracotta mb-8"></div>
    <h1 data-anim="hero-title" class="font-serif italic font-light text-cream leading-[0.85] mb-6" style="font-size:clamp(3.5rem,13vw,14rem)">
      Serena
    </h1>
    <p data-anim="hero-meta" class="label-xs" style="color:var(--cream-70)">
      Santorini, Greece · 4 Suites · 8 Acres · Caldera View
    </p>
  </div>
  <div data-anim="hero-scroll" class="hero-scroll">
    <div data-anim="scroll-line" class="w-px bg-terracotta"></div>
    <span class="label-xs text-cream" style="writing-mode:vertical-rl;transform:rotate(180deg)">SCROLL</span>
  </div>
</section>

<div class="marquee-strip">
  <div data-anim="marquee-container" class="marquee-inner">
    <span>PRIVATE ESTATE · SANTORINI GREECE · CALDERA VIEW · 4 SUITES · INFINITY POOL · </span>
    <span>PRIVATE ESTATE · SANTORINI GREECE · CALDERA VIEW · 4 SUITES · INFINITY POOL · </span>
  </div>
</div>
