---
const navLinks = [
  { href: '#about',    label: 'About'    },
  { href: '#gallery',  label: 'Gallery'  },
  { href: '#location', label: 'Location' },
  { href: '#enquire',  label: 'Enquire'  },
] as const;
---
<script>
import { gsap, ScrollTrigger, sel, isPointer, scrollTo } from '../lib/gsap';

gsap.set(sel('nav-logo'),     { opacity: 0, y: -8 });
gsap.set('[data-nav="link"]', { opacity: 0, y: -8 });

const nav = document.querySelector<HTMLElement>('[data-nav="root"]');

document.addEventListener('casa:loaded', () => {
  gsap.timeline()
    .to(sel('nav-logo'),     { opacity: 1, y: 0, duration: 0.7 })
    .to('[data-nav="link"]', { opacity: 1, y: 0, stagger: 0.07, duration: 0.55 }, '-=0.35');
}, { once: true });

if (isPointer) {
  document.querySelectorAll<HTMLElement>('[data-nav="link"]').forEach(el => {
    const line = document.createElement('span');
    line.style.cssText = 'position:absolute;bottom:-2px;left:0;width:100%;height:1px;display:block;background:var(--color-terracotta);transform-origin:left center;transform:scaleX(0)';
    el.appendChild(line);
    el.addEventListener('mouseenter', () => gsap.to(line, { scaleX: 1, duration: 0.3, ease: 'power2.out' }));
    el.addEventListener('mouseleave', () => gsap.to(line, { scaleX: 0, duration: 0.25, ease: 'power2.in', transformOrigin: 'right center' }));
  });
}

const toggle  = document.querySelector<HTMLElement>('[data-nav="toggle"]');
const overlay = document.querySelector<HTMLElement>('[data-nav="overlay"]');
const [bar0, bar1] = [...document.querySelectorAll<HTMLElement>('[data-nav="bar"]')];
let menuOpen = false;

const openMenu = () => {
  menuOpen = true;
  toggle?.setAttribute('aria-expanded', 'true');
  if (overlay) overlay.style.display = 'flex';
  gsap.fromTo(overlay, { opacity: 0 }, { opacity: 1, duration: 0.3, ease: 'power2.out' });
  gsap.fromTo(overlay?.querySelectorAll('li') ?? [], { y: 24, opacity: 0 }, { y: 0, opacity: 1, stagger: 0.07, duration: 0.4, ease: 'power3.out', delay: 0.1 });
  if (bar0) gsap.to(bar0, { rotation:  45, y:  4, duration: 0.3, ease: 'power2.inOut' });
  if (bar1) gsap.to(bar1, { rotation: -45, y: -4, duration: 0.3, ease: 'power2.inOut' });
};
const closeMenu = (cb?: () => void) => {
  menuOpen = false;
  toggle?.setAttribute('aria-expanded', 'false');
  if (bar0) gsap.to(bar0, { rotation: 0, y: 0, duration: 0.25, ease: 'power2.inOut' });
  if (bar1) gsap.to(bar1, { rotation: 0, y: 0, duration: 0.25, ease: 'power2.inOut' });
  gsap.to(overlay, { opacity: 0, duration: 0.25, ease: 'power2.in', onComplete() { if (overlay) overlay.style.display = 'none'; cb?.(); } });
};

toggle?.addEventListener('click', () => menuOpen ? closeMenu() : openMenu());

overlay?.querySelectorAll<HTMLAnchorElement>('a').forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    const href = a.getAttribute('href') ?? '';
    closeMenu(() => {
      const id = href === '#gallery' && window.innerWidth <= 768 ? '#gallery-mobile' : href;
      const el = document.querySelector(id);
      if (el) scrollTo(el as HTMLElement, 0.8);
    });
  });
});

document.querySelector('[data-nav="logo"]')?.addEventListener('click', e => { e.preventDefault(); scrollTo(0, 1.2); });

// Desktop nav links: smooth scroll instead of jump
document.querySelectorAll<HTMLAnchorElement>('[data-nav="link"]').forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    const target = document.querySelector(a.getAttribute('href') ?? '');
    if (target) scrollTo(target as HTMLElement, 1.0);
  });
});

const allLinks = [...document.querySelectorAll<HTMLElement>('[data-nav="link"]')];
const setActive = (id: string) => {
  allLinks.forEach(l => { l.removeAttribute('aria-current'); l.classList.remove('active'); });
  document.querySelector(`[data-nav="link"][href="#${id}"]`)?.setAttribute('aria-current', 'page');
};

document.querySelectorAll<HTMLElement>('section[data-nav-theme]').forEach(s => {
  ScrollTrigger.create({
    trigger: s, start: 'top 60px', end: 'bottom 60px',
    onEnter:     () => { nav?.classList.toggle('nav-light', s.dataset.navTheme === 'light'); if (s.id) setActive(s.id); },
    onEnterBack: () => { nav?.classList.toggle('nav-light', s.dataset.navTheme === 'light'); if (s.id) setActive(s.id); },
  });
});
</script>

<header class="nav-header">
  <nav data-nav="root" class="nav-bar">
    <a data-nav="logo" data-anim="nav-logo" href="#hero" class="nav-logo">CASA SERENA</a>
    <div class="nav-links">
      {navLinks.map(({ href, label }) => <a data-nav="link" href={href} class="nav-link">{label}</a>)}
    </div>
    <button data-nav="toggle" aria-label="Open menu" aria-expanded="false" class="nav-toggle">
      <span data-nav="bar"></span>
      <span data-nav="bar"></span>
    </button>
  </nav>
</header>

<div data-nav="overlay" class="nav-overlay" style="display:none" aria-hidden="true">
  <ul class="nav-overlay-list">
    {navLinks.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
  </ul>
</div>

