<script>
import { gsap, ScrollTrigger } from '../lib/gsap';

gsap.from('nav a', { opacity: 0, y: -10, stagger: 0.05, duration: 0.6, delay: 0.2 });

const nav = document.querySelector('nav');
const toggle = document.querySelector('[data-nav="toggle"]');
const overlay = document.querySelector('[data-nav="overlay"]');
let open = false;

toggle?.addEventListener('click', () => {
  open = !open;
  overlay?.classList.toggle('hidden', !open);
  document.body.style.overflow = open ? 'hidden' : '';
});

overlay?.querySelectorAll('a').forEach(a => {
  a.addEventListener('click', () => {
    open = false;
    overlay.classList.add('hidden');
    document.body.style.overflow = '';
  });
});

document.querySelectorAll('[data-nav-theme]').forEach(s => {
  ScrollTrigger.create({
    trigger: s as HTMLElement,
    start: 'top 60px',
    end: 'bottom 60px',
    onEnter: () => nav?.classList.toggle('nav-light', (s as HTMLElement).dataset.navTheme === 'light'),
    onEnterBack: () => nav?.classList.toggle('nav-light', (s as HTMLElement).dataset.navTheme === 'light'),
  });
});
</script>

<header class="fixed top-0 left-0 right-0 z-50">
  <nav class="flex justify-between items-center section-px py-5 transition-colors">
    <a href="#hero" class="font-serif text-sm tracking-widest text-cream">CASA SERENA</a>
    <div class="hidden md:flex gap-8">
      <a href="#about" class="label-xs text-cream/80 hover:text-terracotta transition">About</a>
      <a href="#gallery" class="label-xs text-cream/80 hover:text-terracotta transition">Gallery</a>
      <a href="#location" class="label-xs text-cream/80 hover:text-terracotta transition">Location</a>
      <a href="#enquire" class="label-xs text-cream/80 hover:text-terracotta transition">Enquire</a>
    </div>
    <button data-nav="toggle" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menu">
      <span class="w-6 h-0.5 bg-cream transition"></span>
      <span class="w-6 h-0.5 bg-cream transition"></span>
    </button>
  </nav>
</header>

<div data-nav="overlay" class="hidden fixed inset-0 z-40 bg-charcoal flex items-center justify-center">
  <ul class="space-y-4 text-center">
    <li><a href="#about" class="font-serif italic text-5xl text-cream">About</a></li>
    <li><a href="#gallery" class="font-serif italic text-5xl text-cream">Gallery</a></li>
    <li><a href="#location" class="font-serif italic text-5xl text-cream">Location</a></li>
    <li><a href="#enquire" class="font-serif italic text-5xl text-cream">Enquire</a></li>
  </ul>
</div>

