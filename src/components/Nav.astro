<script>
import { gsap, ScrollTrigger } from '../lib/gsap';

gsap.from('nav .nav-logo', { opacity: 0, y: -10, duration: 0.5, delay: 0.1 });
gsap.from('nav .nav-link', { opacity: 0, y: -10, stagger: 0.07, duration: 0.5, delay: 0.3 });

const nav = document.querySelector('nav');
const toggle = document.querySelector('[data-nav="toggle"]');
const overlay = document.querySelector<HTMLElement>('[data-nav="overlay"]');
let open = false;

const closeMenu = () => {
  open = false;
  gsap.to(overlay, { opacity: 0, duration: 0.2, onComplete: () => { overlay!.style.display = 'none'; } });
  document.body.style.overflow = '';
};

toggle?.addEventListener('click', () => {
  if (open) { closeMenu(); return; }
  open = true;
  overlay!.style.display = 'flex';
  gsap.fromTo(overlay, { opacity: 0 }, { opacity: 1, duration: 0.3 });
  gsap.from('[data-nav="overlay"] li', { opacity: 0, y: 20, stagger: 0.07, duration: 0.4, delay: 0.1 });
  document.body.style.overflow = 'hidden';
});

overlay?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));

document.querySelectorAll('[data-nav-theme]').forEach(s => {
  const isLight = () => (s as HTMLElement).dataset.navTheme === 'light';
  ScrollTrigger.create({
    trigger: s as HTMLElement,
    start: 'top 60px',
    end: 'bottom 60px',
    onEnter:     () => nav?.classList.toggle('nav-light', isLight()),
    onEnterBack: () => nav?.classList.toggle('nav-light', isLight()),
  });
});
</script>

<nav class="fixed top-0 left-0 right-0 z-50 flex justify-between items-center section-px py-5 transition-colors">
    <a href="#hero" class="nav-logo font-serif text-sm tracking-widest text-cream">CASA SERENA</a>
    <div class="hidden md:flex gap-8">
      <a href="#about" class="nav-link label-xs text-cream/80 hover:text-terracotta transition">About</a>
      <a href="#gallery" class="nav-link label-xs text-cream/80 hover:text-terracotta transition">Gallery</a>
      <a href="#location" class="nav-link label-xs text-cream/80 hover:text-terracotta transition">Location</a>
      <a href="#enquire" class="nav-link label-xs text-cream/80 hover:text-terracotta transition">Enquire</a>
    </div>
    <button data-nav="toggle" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menu">
      <span class="w-6 h-0.5 bg-cream transition"></span>
      <span class="w-6 h-0.5 bg-cream transition"></span>
    </button>
</nav>

<div data-nav="overlay" style="display:none" class="fixed inset-0 z-40 bg-charcoal items-center justify-center">
  <ul class="space-y-4 text-center">
    <li><a href="#about" class="font-serif italic text-5xl text-cream">About</a></li>
    <li><a href="#gallery" class="font-serif italic text-5xl text-cream">Gallery</a></li>
    <li><a href="#location" class="font-serif italic text-5xl text-cream">Location</a></li>
    <li><a href="#enquire" class="font-serif italic text-5xl text-cream">Enquire</a></li>
  </ul>
</div>
