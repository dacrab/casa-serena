---
import { navLinks, site } from '../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href === path;
---

<nav class="fixed top-0 inset-x-0 z-50 flex justify-between items-center section-px py-4 md:py-5">
  <a href="/" data-intro class="nav-logo font-serif text-sm tracking-widest">{site.name.toUpperCase()}</a>

  <div class="hidden md:flex gap-8">
    {navLinks.map(({ href, label }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined} class:list={["nav-link label-xs", isActive(href) && "nav-link--active"]}>{label}</a>
    ))}
  </div>

  <button
    type="button"
    data-nav-toggle
    aria-label="Toggle menu"
    aria-controls="nav-overlay"
    aria-expanded="false"
    class="md:hidden relative flex flex-col items-center justify-center gap-1.5 w-11 h-11 -mr-2"
  >
    <span data-bar class="bar block w-6 h-0.5 origin-center"></span>
    <span data-bar class="bar block w-6 h-0.5 origin-center"></span>
  </button>
</nav>

<dialog
  id="nav-overlay"
  aria-label="Site navigation"
  class="md:hidden flex-col items-center justify-center"
>
  <button
    type="button"
    data-nav-close
    aria-label="Close menu"
    class="absolute top-4 right-3 flex flex-col items-center justify-center gap-1.5 w-11 h-11"
  >
    <span data-bar class="bar block w-6 h-0.5 origin-center"></span>
    <span data-bar class="bar block w-6 h-0.5 origin-center"></span>
  </button>

  <ul class="space-y-6 text-center">
    {navLinks.map(({ href, label }) => (
      <li>
        <a href={href} aria-current={isActive(href) ? 'page' : undefined} class:list={["font-serif italic text-4xl sm:text-5xl hover:text-terracotta", isActive(href) ? "text-terracotta" : "text-cream"]}>
          {label}
        </a>
      </li>
    ))}
  </ul>
</dialog>

<script>
  import '../scripts/nav';
</script>

<style>
  nav { mix-blend-mode: difference; }
  nav .nav-logo,
  nav .nav-link { color: #fff; }
  nav .nav-link { opacity: 0.8; transition: opacity 0.3s; }
  nav .nav-link:hover { opacity: 1; }
  nav .nav-link--active { opacity: 1; text-decoration: underline; text-underline-offset: 4px; }
  nav .bar { background: #fff; transition: transform 0.2s; }
  [data-nav-toggle].is-open [data-bar]:first-child { transform: rotate(45deg) translateY(4px); }
  [data-nav-toggle].is-open [data-bar]:last-child { transform: rotate(-45deg) translateY(-4px); }
  [data-nav-close] .bar { background: #fff; transition: transform 0.2s; }
  [data-nav-close] [data-bar]:first-child { transform: rotate(45deg) translateY(4px); }
  [data-nav-close] [data-bar]:last-child { transform: rotate(-45deg) translateY(-4px); }
</style>
