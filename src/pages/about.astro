---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import estate from '../assets/images/estate.webp';
import architecture from '../assets/images/architecture.webp';
import door from '../assets/images/door.webp';

const timeline = [
  { year: '1987', text: 'The original villa is built by shipping magnate Alexandros Kiriakos as a family summer retreat on the caldera cliffs.' },
  { year: '1994', text: 'The estate expands to eight acres with the acquisition of adjacent terraced vineyards and olive groves.' },
  { year: '2003', text: 'A devastating earthquake damages the east wing. The family decides not to repair — but to reimagine entirely.' },
  { year: '2017', text: 'Architect Elena Vassilakis is commissioned. She spends a year on-site before drawing a single line.' },
  { year: '2019', text: 'Casa Serena opens as a private luxury residence, welcoming its first guests on the summer solstice.' },
  { year: '2022', text: 'The spa wing and wine cellar are completed. The estate reaches its current, and perhaps final, form.' },
];

const principles = [
  { n: '01', text: 'Every room has a direct relationship with the outdoors — a terrace, a courtyard, or a framed view.' },
  { n: '02', text: 'Materials are sourced within 50 km: volcanic stone, local marble, Santorini earth pigments.' },
  { n: '03', text: 'No air conditioning in common areas — the architecture itself creates cross-ventilation and thermal mass cooling.' },
  { n: '04', text: 'The colour palette is limited to three: white, stone, and the blue of the Aegean.' },
];

const team = [
  {
    name: 'Elena Vassilakis',
    role: 'Architect & Creative Director',
    bio: 'Athens-born, London-trained. Three years studying the light, wind, and stone of Santorini before drawing a single line.',
  },
  {
    name: 'Nikos Papadopoulos',
    role: 'Estate Manager',
    bio: 'Born in Oia. Knows every path, every fisherman, every hidden cove. With the estate since opening day.',
  },
  {
    name: 'Maria Stavrou',
    role: 'Head Chef',
    bio: 'Le Cordon Bleu Paris, returned to Greece to cook the food she grew up eating — elevated, seasonal, rooted in Cycladic terroir.',
  },
  {
    name: 'Dimitris Alexiou',
    role: 'Spa Director',
    bio: 'Former physiotherapist turned wellness practitioner. Combines ancient Greek bathing rituals with modern therapeutic science.',
  },
];

const press = ['Condé Nast Traveller', 'Wallpaper*', 'Monocle', 'Architectural Digest', 'Financial Times HTSI'];
---

<PageLayout
  overHero
  title="About — Casa Serena | Santorini"
  description="The history, architecture, and people behind Casa Serena."
>
  <PageHero
    image={architecture}
    alt="Sculpted whitewashed Cycladic architecture"
    label="About"
    title="Built to Last"
    subtitle="1987 — today"
    index="01 — 06"
  />

  <section class="section shell">
    <div class="grid gap-8 md:grid-cols-12">
      <p data-reveal class="label text-ink-soft md:col-span-3">Our story</p>
      <div class="md:col-span-8 md:col-start-5">
        <h2 data-reveal class="display-md">
          A family house first.<br />
          A hotel <em>second.</em>
        </h2>
        <p data-reveal class="body-lg mt-7 max-w-2xl text-ink-soft">
          Casa Serena began as a private summer retreat — a place for long lunches, bare feet, and the particular quiet
          that settles over the caldera in the late afternoon. It still is.
        </p>
      </div>
    </div>
  </section>

  <section class="shell grid gap-10 pb-16 md:grid-cols-12 md:items-center md:pb-24">
    <figure data-reveal="clip" class="media aspect-[4/5] md:col-span-6 md:col-start-1">
      <Image src={door} alt="A blue door set into a whitewashed wall" loading="lazy" class="img-grade" />
    </figure>
    <div class="md:col-span-5 md:col-start-8">
      <p data-reveal class="label text-ink-soft">Philosophy</p>
      <h2 data-reveal class="display-md mt-6">
        Architecture<br />
        as <em>hospitality.</em>
      </h2>
      <div class="mt-7 max-w-md space-y-4 text-sm leading-relaxed text-ink-soft">
        <p data-reveal>
          Casa Serena was never meant to impress. It was meant to disappear — to let the caldera, the light, and the
          silence do the work.
        </p>
        <p data-reveal>
          Every material was chosen for how it ages: local limestone that whitens in the sun, reclaimed teak that silvers
          with salt air.
        </p>
        <p data-reveal>
          There is no lobby. No reception desk. No key card. You arrive, and you are home.
        </p>
      </div>
    </div>
  </section>

  <section class="section bg-sea text-paper">
    <div class="shell grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <p data-reveal class="label text-paper/45">Timeline</p>
        <h2 data-reveal class="display-md mt-6">
          A house<br />
          with a <em>memory.</em>
        </h2>
      </div>
      <div class="md:col-span-7 md:col-start-6">
        {timeline.map(({ year, text }) => (
          <div
            data-reveal
            class="grid grid-cols-[4.5rem_1fr] gap-4 border-t border-paper/15 py-6 md:grid-cols-[7rem_1fr] md:gap-8"
          >
            <span class="font-serif text-2xl leading-none text-terracotta md:text-3xl">{year}</span>
            <p class="text-sm leading-relaxed text-paper/60">{text}</p>
          </div>
        ))}
        <div class="border-t border-paper/15"></div>
      </div>
    </div>
  </section>

  <section class="relative flex min-h-[60svh] items-end overflow-hidden bg-ink text-paper">
    <Image
      data-reveal="clip"
      src={estate}
      alt="The estate terraces above the caldera"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover img-grade"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/85 via-ink/20 to-ink/40"></div>
    <div class="shell relative w-full pb-12 pt-32 md:pb-16">
      <p data-reveal class="label mb-6 text-paper/50">The house</p>
      <p data-reveal class="display-md max-w-3xl">
        “The house was never meant to impress.<br class="hidden md:block" />
        It was meant to <em>disappear.</em>”
      </p>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="shell">
      <div class="grid gap-8 md:grid-cols-12">
        <p data-reveal class="label text-ink-soft md:col-span-3">Design principles</p>
        <h2 data-reveal class="display-md md:col-span-8 md:col-start-5">
          Four rules,<br />
          held <em>quietly.</em>
        </h2>
      </div>

      <div data-reveal class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        {principles.map(({ n, text }) => (
          <div class="bg-paper p-7 md:p-8">
            <p class="label text-terracotta">{n}</p>
            <p class="mt-6 text-sm leading-relaxed text-ink-soft">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-limestone">
    <div class="shell">
      <div class="grid gap-8 md:grid-cols-12">
        <p data-reveal class="label text-ink-soft md:col-span-3">The people</p>
        <h2 data-reveal class="display-md md:col-span-8 md:col-start-5">
          The ones who<br />
          make it <em>feel.</em>
        </h2>
      </div>

      <div data-reveal class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2">
        {team.map(({ name, role, bio }) => (
          <div class="bg-limestone p-8 md:p-10">
            <h3 class="font-serif text-2xl leading-tight md:text-3xl">{name}</h3>
            <p class="label mt-2 text-terracotta">{role}</p>
            <p class="mt-5 text-sm leading-relaxed text-ink-soft">{bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-ink text-paper">
    <div class="shell">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <p data-reveal class="label text-paper/45">As seen in</p>
        <p data-reveal class="label text-paper/30">Press & recognition</p>
      </div>

      <div class="mt-10 border-t border-paper/15">
        {press.map(name => (
          <p
            data-reveal
            class="cursor-default border-b border-paper/15 py-5 font-serif text-3xl leading-none text-paper/45 transition-colors duration-300 hover:text-paper md:py-6 md:text-5xl"
          >
            {name}
          </p>
        ))}
      </div>

      <div class="mt-14 flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-sm text-sm leading-relaxed text-paper/50">
          The best way to understand the house is to stay in it. Enquiries are handled personally.
        </p>
        <a href="/enquire" class="btn btn-light self-start">Enquire</a>
      </div>
    </div>
  </section>
</PageLayout>
