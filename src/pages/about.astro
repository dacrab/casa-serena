---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import about from '../assets/images/about.webp';
import gallery1 from '../assets/images/gallery-1.webp';
import gallery2 from '../assets/images/gallery-2.webp';

const timeline = [
  { year: '1987', text: 'The original villa is built by shipping magnate Alexandros Kiriakos as a family summer retreat on the caldera cliffs.' },
  { year: '1994', text: 'The estate expands to 8 acres with the acquisition of adjacent terraced vineyards and olive groves.' },
  { year: '2003', text: 'A devastating earthquake damages the east wing. The family decides not to repair — but to reimagine entirely.' },
  { year: '2017', text: 'Architect Elena Vassilakis is commissioned. She spends a year on-site before drawing a single line.' },
  { year: '2019', text: 'Casa Serena opens as a private luxury residence, welcoming its first guests on the summer solstice.' },
  { year: '2022', text: 'The spa wing and wine cellar are completed. The estate reaches its current, and perhaps final, form.' },
];

const principles = [
  { n: '01', text: 'Every room has a direct relationship with the outdoors — a terrace, a courtyard, or a framed view.' },
  { n: '02', text: 'Materials are sourced within 50km: volcanic stone, local marble, Santorini earth pigments.' },
  { n: '03', text: 'No air conditioning in common areas — the architecture itself creates cross-ventilation and thermal mass cooling.' },
  { n: '04', text: 'The colour palette is limited to three: white, stone, and the blue of the Aegean.' },
];

const team = [
  { name: 'Elena Vassilakis', role: 'Architect & Creative Director', bio: 'Athens-born, London-trained. Three years studying the light, wind, and stone of Santorini before drawing a single line.' },
  { name: 'Nikos Papadopoulos', role: 'Estate Manager', bio: 'Born in Oia. Knows every path, every fisherman, every hidden cove. With the estate since opening day.' },
  { name: 'Maria Stavrou', role: 'Head Chef', bio: 'Le Cordon Bleu Paris, returned to Greece to cook the food she grew up eating — elevated, seasonal, rooted in Cycladic terroir.' },
  { name: 'Dimitris Alexiou', role: 'Spa Director', bio: 'Former physiotherapist turned wellness practitioner. Combines ancient Greek bathing rituals with modern therapeutic science.' },
];

const press = ['Condé Nast Traveller', 'Wallpaper*', 'Monocle', 'Architectural Digest', 'Financial Times HTSI'];
---

<PageLayout title="About — Casa Serena | Santorini" description="The history, architecture, and people behind Casa Serena.">
  <PageHero image={gallery1} alt="Casa Serena at golden hour" label="About" title="Built to Last" size="hero" />

  <section class="bg-warm-white grid md:grid-cols-2 min-h-[70vh]">
    <div data-reveal="scale" class="overflow-hidden">
      <Image src={about} alt="Casa Serena interior" loading="lazy" class="w-full h-full object-cover min-h-[50vw] md:min-h-0" />
    </div>
    <div class="flex flex-col justify-center section-px py-16 md:py-24 md:pl-16 lg:pl-24">
      <p data-reveal class="label-xs text-driftwood mb-6">Philosophy</p>
      <h2 data-reveal class="font-serif italic font-light text-charcoal heading-lg leading-tight mb-8">Architecture as hospitality.</h2>
      <div class="space-y-4 max-w-md">
        <p data-reveal class="text-charcoal/60 leading-relaxed">Casa Serena was never meant to impress. It was meant to disappear — to let the caldera, the light, and the silence do the work.</p>
        <p data-reveal class="text-charcoal/60 leading-relaxed">Every material was chosen for how it ages: local limestone that whitens in the sun, reclaimed teak that silvers with salt air.</p>
        <p data-reveal class="text-charcoal/60 leading-relaxed">There is no lobby. No reception desk. No key card. You arrive, and you are home.</p>
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-20 md:py-32 section-px">
    <div class="max-w-3xl mx-auto">
      <p data-reveal class="label-xs text-driftwood mb-12">Timeline</p>
      <div class="relative">
        {timeline.map(({ year, text }, i) => (
          <div data-reveal class="grid md:grid-cols-[8rem_1fr] gap-4 md:gap-12 py-8 border-b border-cream/5 last:border-0">
            <div class="flex items-start gap-3">
              <span class="font-serif text-terracotta/30 text-5xl md:text-7xl font-light leading-none">{year}</span>
              <div class="hidden md:flex flex-col items-center shrink-0 self-stretch relative z-10">
                <div class={`w-px flex-1 bg-cream/10 ${i === 0 ? 'opacity-0' : ''}`}></div>
                <div class="w-2 h-2 rounded-full bg-terracotta/50 shrink-0"></div>
                <div class={`w-px flex-1 bg-cream/10 ${i === timeline.length - 1 ? 'opacity-0' : ''}`}></div>
              </div>
            </div>
            <p class="text-cream/55 leading-relaxed text-sm">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-warm-white">
    <div data-reveal="scale">
      <Image src={gallery2} alt="Estate terraces" loading="lazy" class="w-full h-[55vh] md:h-[65vh] object-cover" />
    </div>
    <div class="section-px py-16 md:py-24 max-w-[1400px] mx-auto">
      <p data-reveal class="label-xs text-driftwood mb-10">Design Principles</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-charcoal/10">
        {principles.map(({ n, text }) => (
          <div data-reveal class="bg-warm-white p-8 md:p-10">
            <p class="font-serif text-terracotta text-4xl font-light mb-6">{n}</p>
            <p class="text-charcoal/60 text-sm leading-relaxed">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-warm-white section-px pb-20 md:pb-32">
    <div class="max-w-[1400px] mx-auto">
      <p data-reveal class="label-xs text-driftwood mb-10">The People</p>
      <div class="grid sm:grid-cols-2 gap-px bg-charcoal/10">
        {team.map(({ name, role, bio }) => (
          <div data-reveal class="bg-warm-white p-8 md:p-12">
            <h3 class="font-serif italic font-light text-charcoal text-2xl md:text-3xl mb-1">{name}</h3>
            <p class="label-xs text-terracotta mb-5">{role}</p>
            <p class="text-charcoal/55 text-sm leading-relaxed">{bio}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-charcoal py-20 md:py-32 section-px">
    <div class="max-w-[1400px] mx-auto">
      <p data-reveal class="label-xs text-driftwood mb-10">As Seen In</p>
      {press.map(name => (
        <p data-reveal class="font-serif italic font-light text-cream/20 hover:text-cream/70 transition-colors duration-300 border-t border-cream/5 py-5 text-3xl md:text-5xl lg:text-6xl leading-none cursor-default">
          {name}
        </p>
      ))}
      <div class="border-t border-cream/5"></div>
    </div>
  </section>
</PageLayout>