---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { Image } from 'astro:assets';
import gallery1 from '../assets/images/gallery-1.webp';
import gallery2 from '../assets/images/gallery-2.webp';
import gallery3 from '../assets/images/gallery-3.webp';
import gallery4 from '../assets/images/gallery-4.webp';
import gallery5 from '../assets/images/gallery-5.webp';
import quote from '../assets/images/quote.webp';
import about from '../assets/images/about.webp';

const images = [
  { src: gallery1, alt: 'Estate exterior at golden hour' },
  { src: quote, alt: 'Infinity pool at sunset' },
  { src: gallery2, alt: 'Beachfront pool terrace' },
  { src: about, alt: 'Living space with caldera views' },
  { src: gallery3, alt: 'Panoramic hillside view' },
  { src: gallery4, alt: 'Chef\'s kitchen' },
  { src: gallery5, alt: 'Master suite at dusk' },
  { src: gallery1, alt: 'Private terrace morning light' },
  { src: gallery2, alt: 'Spa treatment room' },
  { src: quote, alt: 'Pool at twilight' },
  { src: gallery3, alt: 'Garden pathway' },
  { src: gallery5, alt: 'Suite bathroom detail' },
];
---

<Layout
  title="Gallery — Casa Serena | Santorini"
  description="Explore Casa Serena through our gallery — the estate, suites, pool, and caldera views."
>
  <Nav />
  <main>
    <!-- Hero: first image full viewport -->
    <section class="relative h-screen overflow-hidden">
      <Image data-intro src={images[0]!.src} alt={images[0]!.alt} loading="eager" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/40 to-transparent"></div>
      <p data-intro class="absolute bottom-8 left-0 section-px text-cream/60 text-xs tracking-wide">{images[0]!.alt}</p>
    </section>

    <!-- Remaining images -->
    <section class="py-32 md:py-48 space-y-32 md:space-y-48">
      {images.slice(1).map((img, i) => (
        <figure data-reveal class="section-px max-w-[1400px] mx-auto cursor-pointer" data-lightbox-trigger={i + 1}>
          <Image src={img.src} alt={img.alt} loading="lazy" class="w-full object-cover" />
          <figcaption class="mt-4 text-xs text-driftwood/70 tracking-wide">{img.alt}</figcaption>
        </figure>
      ))}
    </section>
  </main>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 z-[100] bg-charcoal/95 hidden items-center justify-center" aria-hidden="true" role="dialog" aria-label="Image lightbox">
    <button id="lb-close" class="absolute top-6 right-6 text-cream/60 hover:text-cream text-sm tracking-wide z-10" aria-label="Close lightbox">Close</button>
    <button id="lb-prev" class="absolute left-6 top-1/2 -translate-y-1/2 text-cream/60 hover:text-cream text-2xl z-10" aria-label="Previous image">&#8592;</button>
    <button id="lb-next" class="absolute right-6 top-1/2 -translate-y-1/2 text-cream/60 hover:text-cream text-2xl z-10" aria-label="Next image">&#8594;</button>
    <img id="lb-img" class="max-h-[85vh] max-w-[90vw] object-contain" alt="" />
    <p id="lb-caption" class="absolute bottom-8 left-1/2 -translate-x-1/2 text-cream/50 text-xs tracking-wide"></p>
  </div>

  <script>
    const lightbox = document.getElementById('lightbox')!;
    const lbImg = document.getElementById('lb-img') as HTMLImageElement;
    const lbCaption = document.getElementById('lb-caption')!;
    const figures = document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]');
    const heroSection = document.querySelector<HTMLElement>('main > section:first-child')!;

    interface LBImage { src: string; alt: string }
    const allImages: LBImage[] = [];
    const heroImg = heroSection.querySelector('img')!;
    allImages.push({ src: heroImg.currentSrc || heroImg.src, alt: heroImg.alt });
    figures.forEach(fig => {
      const img = fig.querySelector('img');
      if (img) allImages.push({ src: img.currentSrc || img.src, alt: img.alt });
    });

    let current = 0;
    let touchStartX = 0;

    function open(index: number) {
      current = index;
      show();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    function show() {
      const img = allImages[current]!;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lbCaption.textContent = img.alt;
    }

    function prev() { current = (current - 1 + allImages.length) % allImages.length; show(); }
    function next() { current = (current + 1) % allImages.length; show(); }

    // Click hero to open
    heroSection.addEventListener('click', () => open(0));
    heroSection.style.cursor = 'pointer';

    figures.forEach(fig => {
      fig.addEventListener('click', () => {
        const idx = parseInt(fig.dataset.lightboxTrigger || '0') + 1;
        open(idx);
      });
    });

    document.getElementById('lb-close')!.addEventListener('click', close);
    document.getElementById('lb-prev')!.addEventListener('click', prev);
    document.getElementById('lb-next')!.addEventListener('click', next);

    // Keyboard
    document.addEventListener('keydown', e => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    // Swipe
    lightbox.addEventListener('touchstart', e => { touchStartX = e.touches[0]!.clientX; }, { passive: true });
    lightbox.addEventListener('touchend', e => {
      const diff = e.changedTouches[0]!.clientX - touchStartX;
      if (Math.abs(diff) > 50) diff > 0 ? prev() : next();
    });
  </script>
</Layout>
