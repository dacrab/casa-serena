---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import gallery1 from '../assets/images/gallery-1.webp';
import gallery2 from '../assets/images/gallery-2.webp';
import gallery3 from '../assets/images/gallery-3.webp';
import gallery4 from '../assets/images/gallery-4.webp';
import gallery5 from '../assets/images/gallery-5.webp';
import quote from '../assets/images/quote.webp';
import about from '../assets/images/about.webp';

const images = [
  { src: gallery1, alt: 'Estate exterior at golden hour' },
  { src: quote,    alt: 'Infinity pool at sunset' },
  { src: gallery2, alt: 'Beachfront pool terrace' },
  { src: about,    alt: 'Living space with caldera views' },
  { src: gallery3, alt: 'Panoramic hillside view' },
  { src: gallery4, alt: "Chef's kitchen" },
  { src: gallery5, alt: 'Master suite at dusk' },
  { src: gallery1, alt: 'Private terrace morning light' },
  { src: gallery2, alt: 'Spa treatment room' },
  { src: quote,    alt: 'Pool at twilight' },
  { src: gallery3, alt: 'Garden pathway' },
  { src: gallery5, alt: 'Suite bathroom detail' },
];

type GalleryCell = {
  /** Index into `images`. */
  image: number;
  /** Lightbox trigger index — ordering is intentionally irregular, preserve as-is. */
  trigger: number;
  /** Grid span, when the cell is wider than one column. */
  span?: 2;
  /** Image aspect ratio; omitted = square (uses `aspect-square` on the cell). */
  aspect?: '16/9' | '3/4' | '4/3' | '21/9';
  /** Whether the image gets `h-full` (off only for the lone 21/9 banner). */
  hFull?: boolean;
};

type GalleryBlock = {
  /** Grid wrapper class; omitted = full-width single cell without a wrapper. Kept as a static literal so Tailwind can scan it. */
  wrap?: string;
  cells: GalleryCell[];
};

const blocks: GalleryBlock[] = [
  {
    wrap: 'grid grid-cols-3 gap-3 md:gap-4',
    cells: [
      { image: 1, trigger: 1, span: 2, aspect: '16/9' },
      { image: 2, trigger: 2, aspect: '3/4' },
    ],
  },
  {
    wrap: 'grid grid-cols-3 gap-3 md:gap-4',
    cells: [
      { image: 3, trigger: 3 },
      { image: 4, trigger: 4 },
      { image: 5, trigger: 5 },
    ],
  },
  {
    wrap: 'grid grid-cols-3 gap-3 md:gap-4',
    cells: [
      { image: 6, trigger: 6, aspect: '3/4' },
      { image: 7, trigger: 7, span: 2, aspect: '16/9' },
    ],
  },
  {
    wrap: 'grid grid-cols-2 gap-3 md:gap-4',
    cells: [
      { image: 8, trigger: 8, aspect: '4/3' },
      { image: 9, trigger: 9, aspect: '4/3' },
    ],
  },
  {
    // Full-width 21/9 banner — no grid wrapper.
    cells: [{ image: 10, trigger: 10, aspect: '21/9', hFull: false }],
  },
  {
    wrap: 'grid grid-cols-3 gap-3 md:gap-4 pb-4 md:pb-6',
    cells: [
      { image: 11, trigger: 11 },
      { image: 0, trigger: 0, aspect: '3/4' },
      { image: 4, trigger: 4 },
    ],
  },
];
---

<PageLayout title="Gallery — Casa Serena | Santorini" description="Explore Casa Serena through our gallery — the estate, suites, pool, and caldera views." mainClass="bg-gallery-bg min-h-screen">
  <PageHero
    image={about}
    alt="Casa Serena interior living space"
    label="Gallery"
    title="The Estate"
    caption={images[0]!.alt}
  />

  <section class="section-px py-4 md:py-6 space-y-3 md:space-y-4">
    {blocks.map(({ wrap, cells }) =>
      wrap ? (
        <div class={wrap}>
          {cells.map(({ image, trigger, span, aspect, hFull = true }) => (
            <div data-reveal class={`${span ? 'col-span-2 ' : ''}overflow-hidden${aspect ? '' : ' aspect-square'} cursor-pointer`} data-lightbox-trigger={trigger}>
              <Image src={images[image]!.src} alt={images[image]!.alt} loading="lazy" class={`w-full${hFull ? ' h-full' : ''} object-cover gallery-img`} style={aspect && `aspect-ratio:${aspect}`} />
            </div>
          ))}
        </div>
      ) : (
        cells.map(({ image, trigger, span, aspect, hFull = true }) => (
          <div data-reveal class={`${span ? 'col-span-2 ' : ''}overflow-hidden${aspect ? '' : ' aspect-square'} cursor-pointer`} data-lightbox-trigger={trigger}>
            <Image src={images[image]!.src} alt={images[image]!.alt} loading="lazy" class={`w-full${hFull ? ' h-full' : ''} object-cover gallery-img`} style={aspect && `aspect-ratio:${aspect}`} />
          </div>
        ))
      )
    )}
  </section>

  <dialog id="lightbox" aria-label="Image lightbox">
    <button id="lb-close" class="absolute top-5 right-6 label-xs text-cream/50 hover:text-cream z-10" aria-label="Close">✕ Close</button>
    <button id="lb-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-cream/40 hover:text-cream text-3xl z-10 w-12 h-12 flex items-center justify-center" aria-label="Previous">&#8592;</button>
    <button id="lb-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-cream/40 hover:text-cream text-3xl z-10 w-12 h-12 flex items-center justify-center" aria-label="Next">&#8594;</button>
    <img id="lb-img" class="max-h-[88vh] max-w-[88vw] object-contain" alt="" />
    <p id="lb-caption" class="absolute bottom-6 left-1/2 -translate-x-1/2 label-xs text-cream/40"></p>
  </dialog>

  <script>
    import '../scripts/gallery';
  </script>
</PageLayout>