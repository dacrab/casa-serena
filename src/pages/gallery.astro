---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import caldera from '../assets/images/caldera.webp';
import pool from '../assets/images/pool.webp';
import estate from '../assets/images/estate.webp';
import architecture from '../assets/images/architecture.webp';
import terrace from '../assets/images/terrace.webp';
import garden from '../assets/images/garden.webp';
import door from '../assets/images/door.webp';
import sunset from '../assets/images/sunset.webp';
import boats from '../assets/images/boats.webp';
import detail from '../assets/images/detail.webp';
import sea from '../assets/images/sea.webp';
import heroPoster from '../assets/images/hero-poster.webp';

const images = [
  { src: caldera, alt: 'The caldera and the village of Oia from above', caption: 'Oia and the caldera' },
  { src: estate, alt: 'The pool terrace, shaded by whitewashed walls', caption: 'The pool terrace' },
  { src: terrace, alt: 'A whitewashed dome against the Aegean', caption: 'The dome, at noon' },
  { src: pool, alt: 'A plunge pool above the caldera', caption: 'The plunge pool' },
  { src: architecture, alt: 'Sculpted whitewashed Cycladic architecture', caption: 'White on white' },
  { src: garden, alt: 'Succulents on a wall above the caldera', caption: 'The garden wall' },
  { src: door, alt: 'A blue door set into a whitewashed wall', caption: 'The blue door' },
  { src: detail, alt: 'Pots and succulents on a sunlit wall', caption: 'Morning, on the wall' },
  { src: sunset, alt: 'The caldera at sunset', caption: 'Sunset, from the terrace' },
  { src: boats, alt: 'A fishing boat below the caldera cliffs', caption: 'Below the cliffs' },
  { src: sea, alt: 'The open Aegean', caption: 'The open Aegean' },
  { src: heroPoster, alt: 'The estate seen from above', caption: 'The estate, from the west' },
];

const aspects = [
  'aspect-[4/3]',
  'aspect-[3/4]',
  'aspect-[4/5]',
  'aspect-[3/4]',
  'aspect-square',
  'aspect-square',
  'aspect-[4/3]',
  'aspect-[3/4]',
  'aspect-[4/5]',
  'aspect-square',
  'aspect-[16/9]',
  'aspect-[16/10]',
];
---

<PageLayout
  overHero
  title="Gallery — Casa Serena | Santorini"
  description="Explore Casa Serena through the estate, the suites, the pool, and the caldera."
>
  <PageHero
    image={caldera}
    alt="The caldera and the village of Oia"
    label="Gallery"
    title="The Estate"
    subtitle="Twelve frames · Oia, Santorini"
    index="01 — 12"
  />

  <section class="section shell">
    <div class="mb-12 flex flex-col gap-4 border-b border-line pb-5 sm:flex-row sm:items-end sm:justify-between md:mb-16">
      <p data-reveal class="label text-ink-soft">Selected frames</p>
      <p data-reveal class="max-w-sm text-sm leading-relaxed text-ink-soft">
        The house, the island, and the light at different hours. Click any frame to view it full-screen.
      </p>
    </div>

    <div class="columns-2 gap-3 md:columns-3 md:gap-4">
      {images.map((item, i) => (
        <figure data-reveal class="mb-3 break-inside-avoid md:mb-4">
          <button
            type="button"
            data-lightbox-trigger={i}
            data-lightbox-src={item.src.src}
            data-lightbox-caption={item.caption}
            aria-label={`View image: ${item.alt}`}
            aria-haspopup="dialog"
            class:list={['media block w-full overflow-hidden', aspects[i]]}
          >
            <Image
              src={item.src}
              alt={item.alt}
              widths={[480, 960, 1600].filter(width => width <= item.src.width)}
              sizes="(min-width: 768px) 33vw, 50vw"
              loading="lazy"
              class="img-grade"
            />
          </button>
          <figcaption class="caption mt-2 flex items-baseline justify-between gap-3">
            <span>{item.caption}</span>
            <span class="text-ink-soft/50">{String(i + 1).padStart(2, '0')}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <dialog id="lightbox" aria-label="Image lightbox">
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between border-b border-paper/10 px-5 py-4">
        <p class="label text-paper/45">Casa Serena · Gallery</p>
        <button id="lb-close" class="label flex h-11 items-center gap-2 text-paper/60 transition-colors hover:text-paper" aria-label="Close">
          Close <span aria-hidden="true">✕</span>
        </button>
      </div>

      <div class="relative flex flex-1 items-center justify-center p-4 md:p-8">
        <button
          id="lb-prev"
          class="absolute left-3 z-10 flex h-12 w-12 items-center justify-center border border-paper/15 text-xl text-paper/60 transition-colors hover:border-paper/40 hover:text-paper md:left-8"
          aria-label="Previous image">←</button
        >
        <img id="lb-img" class="max-h-[76vh] max-w-[86vw] object-contain" alt="" />
        <button
          id="lb-next"
          class="absolute right-3 z-10 flex h-12 w-12 items-center justify-center border border-paper/15 text-xl text-paper/60 transition-colors hover:border-paper/40 hover:text-paper md:right-8"
          aria-label="Next image">→</button
        >
      </div>

      <p id="lb-caption" class="label pb-6 text-center text-paper/45"></p>
    </div>
  </dialog>

  <script>
    import '../scripts/gallery';
  </script>
</PageLayout>
