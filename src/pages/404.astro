---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found — Casa Serena">
  <main class="min-h-svh bg-charcoal flex items-center justify-center section-px">
    <div class="flex flex-col items-center text-center gap-5 max-w-md">
      <p aria-hidden="true" class="font-light text-cream/[0.06] leading-none tracking-[0.05em] heading-xl">
        404
      </p>
      <div class="w-12 h-px bg-terracotta" aria-hidden="true"></div>
      <h1 class="font-serif italic font-light text-cream leading-none heading-lg">
        Lost at sea.
      </h1>
      <p class="text-sm text-driftwood tracking-wider">
        This page doesn't exist — but the estate does.
      </p>
      <a
        href="/"
        class="btn-outline label-xs mt-4 gap-3"
      >
        Return to Casa Serena
      </a>
    </div>
  </main>
</Layout>
