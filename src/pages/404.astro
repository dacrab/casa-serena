---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import sea from '../assets/images/sea.webp';
---

<Layout title="Page Not Found — Casa Serena">
  <main class="relative flex min-h-svh items-center justify-center overflow-hidden bg-ink text-paper">
    <Image
      src={sea}
      alt=""
      widths={[480, 960, 1600]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover opacity-70 img-grade"
    />
    <div class="absolute inset-0 bg-ink/55"></div>

    <a href="/" class="absolute left-1/2 top-6 z-10 -translate-x-1/2 font-serif text-2xl leading-none">Casa Serena</a>

    <div class="shell relative flex flex-col items-center text-center">
      <p class="label text-paper/50">404</p>
      <h1 class="display-xl mt-4">
        Lost<br />
        <em>at sea.</em>
      </h1>
      <p class="mt-6 text-sm text-paper/60">This page doesn't exist — but the estate does.</p>
      <a href="/" class="btn btn-light mt-9">Return to Casa Serena</a>
    </div>
  </main>
</Layout>
