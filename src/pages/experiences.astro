---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { Image } from 'astro:assets';
import gallery3 from '../assets/images/gallery-3.webp';
import gallery4 from '../assets/images/gallery-4.webp';
import quote from '../assets/images/quote.webp';
import about from '../assets/images/about.webp';

const experiences = [
  {
    title: 'Private Dining',
    image: gallery4,
    phrase: 'Farm, sea, table.',
    body: 'Our resident chef sources daily from Ammoudi Bay fishermen, the estate\'s herb garden, and volcanic-soil farms. Every meal is a conversation — tell us what you love, and we\'ll create something unrepeatable.',
    offerings: ['Daily organic breakfast, served wherever you wish', 'Multi-course tasting dinners with Cycladic wine pairing', 'Sunset aperitivo on the caldera terrace', 'Private wine cellar tastings', 'Hands-on cooking class with market visit'],
  },
  {
    title: 'Spa & Wellness',
    image: quote,
    phrase: 'Stillness as luxury.',
    body: 'The spa is carved into the cliff — vaulted chambers where time dissolves. Heated marble underfoot, volcanic stone walls, the distant sound of the Aegean. Every treatment uses what the island gives: olive oil, volcanic clay, thyme honey, sea salt.',
    offerings: ['Volcanic stone massage', 'Caldera clay facial', 'Couples hammam ritual', 'Sunrise yoga on the terrace', 'Marble steam room & cold plunge'],
  },
  {
    title: 'Island & Sea',
    image: gallery3,
    phrase: 'Beyond the estate.',
    body: 'Santorini is best discovered slowly — by sail, by foot, by taste. We listen to what moves you, then build the day around it. A private catamaran to a beach with no name. A sunset hike with nobody else in sight.',
    offerings: ['Private catamaran — swim, snorkel, dine on board', 'Volcanic hot springs & crater hike', 'Estate winery tour with vineyard lunch', 'Akrotiri ruins with private archaeologist', 'Helicopter transfer from Athens'],
  },
  {
    title: 'Concierge',
    image: about,
    phrase: 'Before you ask.',
    body: 'The best service is invisible. The car is waiting before you reach the door. The restaurant has your favourite table. The boat is fuelled and the captain knows where the dolphins are today.',
    offerings: ['Airport transfers', 'Priority restaurant reservations island-wide', 'Event production — proposals, birthdays, celebrations', 'Multilingual childcare on 24h notice', 'Personal shopping from island boutiques'],
  },
];
---

<Layout
  title="Experiences — Casa Serena | Santorini"
  description="Private dining, cliff-carved spa, island excursions, and anticipatory concierge at Casa Serena."
>
  <Nav />
  <main>
    <section class="relative h-svh flex items-end overflow-hidden">
      <Image data-intro src={quote} alt="Infinity pool at golden hour" loading="eager" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/60 to-transparent"></div>
      <div class="relative section-px pb-16 md:pb-24 w-full">
        <p data-intro class="label-xs text-cream/50 mb-3 tracking-[0.3em]">Experiences</p>
        <h1 data-intro class="font-serif italic font-light text-cream heading-hero leading-none">Live</h1>
      </div>
    </section>

    {experiences.map((exp) => (
      <section class="bg-warm-white py-20 md:py-32">
        <div data-reveal class="w-full">
          <Image src={exp.image} alt={exp.title} loading="lazy" class="w-full h-[60vh] md:h-[75vh] object-cover" />
        </div>
        <div class="max-w-2xl mx-auto section-px pt-12 md:pt-16">
          <p data-reveal class="label-xs text-charcoal/40 mb-3">{exp.title}</p>
          <p data-reveal class="font-serif italic text-charcoal/80 text-lg md:text-xl mb-6">{exp.phrase}</p>
          <p data-reveal class="text-charcoal/60 leading-relaxed mb-10">{exp.body}</p>
          <ul data-reveal class="space-y-2">
            {exp.offerings.map((o) => (
              <li class="text-sm text-charcoal/50 leading-relaxed">{o}</li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </main>
</Layout>
