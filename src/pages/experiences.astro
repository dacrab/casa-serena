---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import gallery3 from '../assets/images/gallery-3.webp';
import gallery4 from '../assets/images/gallery-4.webp';
import quote from '../assets/images/quote.webp';
import about from '../assets/images/about.webp';

const experiences = [
  {
    title: 'Private Dining', index: '01', image: gallery4, phrase: 'Farm, sea, table.',
    body: "Our resident chef sources daily from Ammoudi Bay fishermen, the estate's herb garden, and volcanic-soil farms. Every meal is a conversation — tell us what you love, and we'll create something unrepeatable.",
    offerings: ['Daily organic breakfast, served wherever you wish', 'Multi-course tasting dinners with Cycladic wine pairing', 'Sunset aperitivo on the caldera terrace', 'Private wine cellar tastings', 'Hands-on cooking class with market visit'],
    dark: false,
  },
  {
    title: 'Spa & Wellness', index: '02', image: quote, phrase: 'Stillness as luxury.',
    body: 'The spa is carved into the cliff — vaulted chambers where time dissolves. Heated marble underfoot, volcanic stone walls, the distant sound of the Aegean. Every treatment uses what the island gives.',
    offerings: ['Volcanic stone massage', 'Caldera clay facial', 'Couples hammam ritual', 'Sunrise yoga on the terrace', 'Marble steam room & cold plunge'],
    dark: true,
  },
  {
    title: 'Island & Sea', index: '03', image: gallery3, phrase: 'Beyond the estate.',
    body: 'Santorini is best discovered slowly — by sail, by foot, by taste. We listen to what moves you, then build the day around it. A private catamaran to a beach with no name.',
    offerings: ['Private catamaran — swim, snorkel, dine on board', 'Volcanic hot springs & crater hike', 'Estate winery tour with vineyard lunch', 'Akrotiri ruins with private archaeologist', 'Helicopter transfer from Athens'],
    dark: false,
  },
  {
    title: 'Concierge', index: '04', image: about, phrase: 'Before you ask.',
    body: 'The best service is invisible. The car is waiting before you reach the door. The restaurant has your favourite table. The boat is fuelled and the captain knows where the dolphins are today.',
    offerings: ['Airport transfers', 'Priority restaurant reservations island-wide', 'Event production — proposals, birthdays, celebrations', 'Multilingual childcare on 24h notice', 'Personal shopping from island boutiques'],
    dark: true,
  },
];

const darkStyles = (dark: boolean) => ({
  bg: dark ? 'bg-charcoal' : 'bg-warm-white',
  text: dark ? 'text-cream' : 'text-charcoal',
  muted: dark ? 'text-cream/50' : 'text-charcoal/50',
  border: dark ? 'border-cream/10' : 'border-charcoal/10',
  ghost: dark ? 'text-cream/10' : 'text-charcoal/10',
});
---

<PageLayout title="Experiences — Casa Serena | Santorini" description="Private dining, cliff-carved spa, island excursions, and anticipatory concierge at Casa Serena.">
  <PageHero image={quote} alt="Infinity pool at golden hour" label="Experiences" title="Live" size="hero" />

  {experiences.map((exp) => {
    const { bg, text, muted, border, ghost } = darkStyles(exp.dark);
    return (
      <section class={bg}>
        <div data-reveal="scale" class="overflow-hidden">
          <Image src={exp.image} alt={exp.title} loading="lazy" class="w-full h-[55vh] md:h-[70vh] object-cover" />
        </div>
        <div class="section-px py-16 md:py-24 max-w-[1400px] mx-auto grid md:grid-cols-2 gap-12 md:gap-20">
          <div>
            <div class="flex items-baseline gap-4 mb-6">
              <span class={`font-serif text-5xl md:text-7xl font-light ${ghost}`}>{exp.index}</span>
              <div>
                <p data-reveal class="label-xs text-terracotta mb-1">{exp.title}</p>
                <h2 data-reveal class={`font-serif italic font-light heading-md leading-tight ${text}`}>{exp.phrase}</h2>
              </div>
            </div>
            <p data-reveal class={`${muted} leading-relaxed text-sm max-w-md`}>{exp.body}</p>
          </div>
          <div>
            <p data-reveal class={`label-xs ${muted} mb-6`}>What's included</p>
            <ul>
              {exp.offerings.map((o) => (
                <li data-reveal class={`text-sm ${muted} py-4 border-b ${border} flex items-start gap-3`}>
                  <span class="text-terracotta mt-0.5 shrink-0">—</span>{o}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}
</PageLayout>