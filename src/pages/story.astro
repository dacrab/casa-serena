---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import { Image } from 'astro:assets';
import about from '../assets/images/about.webp';
import gallery1 from '../assets/images/gallery-1.webp';
import gallery2 from '../assets/images/gallery-2.webp';
import gallery3 from '../assets/images/gallery-3.webp';
import gallery5 from '../assets/images/gallery-5.webp';

const timeline = [
  { year: '1987', text: 'The original villa is built by shipping magnate Alexandros Kiriakos as a family summer retreat on the caldera cliffs.' },
  { year: '1994', text: 'The estate expands to 8 acres with the acquisition of adjacent terraced vineyards and olive groves.' },
  { year: '2003', text: 'A devastating earthquake damages the east wing. The family decides not to repair — but to reimagine entirely.' },
  { year: '2017', text: 'Architect Elena Vassilakis is commissioned. She spends a year on-site before drawing a single line.' },
  { year: '2019', text: 'Casa Serena opens as a private luxury residence, welcoming its first guests on the summer solstice.' },
  { year: '2022', text: 'The spa wing and wine cellar are completed. The estate reaches its current, and perhaps final, form.' },
];

const principles = [
  'Every room has a direct relationship with the outdoors — a terrace, a courtyard, or a framed view.',
  'Materials are sourced within 50km: volcanic stone, local marble, Santorini earth pigments.',
  'No air conditioning in common areas — the architecture itself creates cross-ventilation and thermal mass cooling.',
  'The colour palette is limited to three: white, stone, and the blue of the Aegean.',
];

const team = [
  { name: 'Elena Vassilakis', role: 'Architect & Creative Director', bio: 'Athens-born, London-trained. Three years studying the light, wind, and stone of Santorini before drawing a single line.' },
  { name: 'Nikos Papadopoulos', role: 'Estate Manager', bio: 'Born in Oia. Knows every path, every fisherman, every hidden cove. With the estate since opening day.' },
  { name: 'Maria Stavrou', role: 'Head Chef', bio: 'Le Cordon Bleu Paris, returned to Greece to cook the food she grew up eating — elevated, seasonal, rooted in Cycladic terroir.' },
  { name: 'Dimitris Alexiou', role: 'Spa Director', bio: 'Former physiotherapist turned wellness practitioner. Combines ancient Greek bathing rituals with modern therapeutic science.' },
];
---

<Layout
  title="Our Story — Casa Serena | Santorini"
  description="The history, architecture, and people behind Casa Serena — a private estate on the caldera cliffs of Santorini."
>
  <Nav />
  <main>
    <section class="relative h-svh flex items-end overflow-hidden">
      <Image data-intro src={gallery1} alt="Casa Serena at golden hour" loading="eager" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/60 to-transparent"></div>
      <div class="relative section-px pb-16 md:pb-24 w-full">
        <p data-intro class="label-xs text-cream/50 mb-3 tracking-[0.3em]">Our Story</p>
        <h1 data-intro class="font-serif italic font-light text-cream heading-hero leading-none">Built to Last</h1>
      </div>
    </section>

    <!-- Philosophy -->
    <section class="bg-warm-white py-20 md:py-32">
      <div data-reveal class="w-full">
        <Image src={about} alt="Casa Serena interior" loading="eager" class="w-full h-[60vh] md:h-[75vh] object-cover" />
      </div>
      <div class="max-w-2xl mx-auto section-px pt-12 md:pt-16">
        <p data-reveal class="label-xs text-charcoal/40 mb-3">Philosophy</p>
        <p data-reveal class="font-serif italic text-charcoal/80 text-lg md:text-xl mb-6">Architecture as hospitality.</p>
        <p data-reveal class="text-charcoal/60 leading-relaxed mb-5">Casa Serena was never meant to impress. It was meant to disappear — to let the caldera, the light, and the silence do the work.</p>
        <p data-reveal class="text-charcoal/60 leading-relaxed mb-5">Every material was chosen for how it ages: local limestone that whitens in the sun, reclaimed teak that silvers with salt air, hand-troweled plaster that catches the golden hour.</p>
        <p data-reveal class="text-charcoal/60 leading-relaxed">There is no lobby. No reception desk. No key card. You arrive, and you are home.</p>
      </div>
    </section>

    <!-- Timeline -->
    <section class="bg-warm-white py-20 md:py-32">
      <div data-reveal class="w-full">
        <Image src={gallery2} alt="Estate terraces" loading="lazy" class="w-full h-[60vh] md:h-[75vh] object-cover" />
      </div>
      <div class="max-w-2xl mx-auto section-px pt-12 md:pt-16">
        <p data-reveal class="label-xs text-charcoal/40 mb-3">Timeline</p>
        <p data-reveal class="font-serif italic text-charcoal/80 text-lg md:text-xl mb-10">A brief history.</p>
        <div class="space-y-8">
          {timeline.map(({ year, text }) => (
            <div data-reveal>
              <p class="text-sm text-terracotta mb-1">{year}</p>
              <p class="text-charcoal/60 leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Design Principles -->
    <section class="bg-warm-white py-20 md:py-32">
      <div data-reveal class="w-full">
        <Image src={gallery3} alt="Panoramic estate view" loading="lazy" class="w-full h-[60vh] md:h-[75vh] object-cover" />
      </div>
      <div class="max-w-2xl mx-auto section-px pt-12 md:pt-16">
        <p data-reveal class="label-xs text-charcoal/40 mb-3">Design Principles</p>
        <p data-reveal class="font-serif italic text-charcoal/80 text-lg md:text-xl mb-10">Less building. More landscape.</p>
        <div class="space-y-6">
          {principles.map((text) => (
            <p data-reveal class="text-charcoal/60 leading-relaxed">{text}</p>
          ))}
        </div>
      </div>
    </section>

    <!-- Team -->
    <section class="bg-warm-white py-20 md:py-32">
      <div data-reveal class="w-full">
        <Image src={gallery5} alt="The estate team" loading="lazy" class="w-full h-[60vh] md:h-[75vh] object-cover" />
      </div>
      <div class="max-w-2xl mx-auto section-px pt-12 md:pt-16">
        <p data-reveal class="label-xs text-charcoal/40 mb-3">The People</p>
        <p data-reveal class="font-serif italic text-charcoal/80 text-lg md:text-xl mb-10">Behind the silence.</p>
        <div class="space-y-8">
          {team.map(({ name, role, bio }) => (
            <div data-reveal>
              <p class="text-charcoal text-sm font-medium">{name}</p>
              <p class="text-charcoal/40 text-xs mb-2">{role}</p>
              <p class="text-charcoal/60 text-sm leading-relaxed">{bio}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Press -->
    <section class="bg-warm-white py-20 md:py-32 section-px">
      <div class="max-w-2xl mx-auto">
        <p data-reveal class="label-xs text-charcoal/40 mb-6">Press</p>
        <div data-reveal class="space-y-2 text-sm text-charcoal/50">
          <p>Condé Nast Traveller</p>
          <p>Wallpaper*</p>
          <p>Monocle</p>
          <p>Architectural Digest</p>
          <p>Financial Times HTSI</p>
        </div>
      </div>
    </section>
  </main>
</Layout>
