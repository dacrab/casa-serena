---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Image } from 'astro:assets';
import { suites } from '../data/suites';
import gallery5 from '../assets/images/gallery-5.webp';
---

<PageLayout title="Suites — Casa Serena | Santorini" description="Four distinct suites perched on the caldera cliffs. From the signature Caldera Suite to the intimate Cliff Studio.">
  <PageHero
    image={gallery5}
    alt="Suite interior at dusk"
    label="Accommodations"
    title="Our Suites"
    subtitle="Four distinct retreats · From €1,200/night"
  />

  {suites.map((suite) => (
    <section class="relative h-svh overflow-hidden flex items-end">
      <Image data-reveal="scale" src={suite.image} alt={`${suite.name} interior`} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
      <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/30 to-transparent"></div>
      <div class="relative w-full section-px pb-10 md:pb-16">
        <div class="grid md:grid-cols-[1fr_auto] gap-6 md:gap-16 items-end">
          <div data-reveal>
            <div class="flex items-baseline gap-4 mb-3">
              <span class="font-serif text-terracotta/60 text-6xl md:text-8xl font-light leading-none">{suite.index}</span>
              <div>
                <p class="label-xs text-cream/40 mb-1">{suite.tagline}</p>
                <h2 class="font-serif italic font-light text-cream heading-md leading-tight">{suite.name}</h2>
              </div>
            </div>
            <p class="text-cream/60 text-sm leading-relaxed max-w-lg mb-6">{suite.description}</p>
            <div class="flex flex-wrap gap-2 mb-6">
              {suite.features.map(f => (
                <span class="text-xs text-cream/40 border border-cream/10 px-3 py-1">{f}</span>
              ))}
            </div>
          </div>
          <div data-reveal class="text-right shrink-0">
            <p class="font-serif text-cream text-3xl md:text-4xl font-light">{suite.price}</p>
            <p class="label-xs text-driftwood mt-1">per night</p>
            <p class="text-xs text-cream/40 mt-1">{suite.size} · {suite.view}</p>
            <a href={`/enquire?suite=${encodeURIComponent(suite.name)}`} class="btn-outline label-xs mt-5">Reserve</a>
          </div>
        </div>
      </div>
    </section>
  ))}
</PageLayout>