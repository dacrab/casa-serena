---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Gallery from '../components/Gallery.astro';
import Amenities from '../components/Amenities.astro';
import Location from '../components/Location.astro';
import Enquire from '../components/Enquire.astro';

const testimonials = [
  { quote: 'We\'ve stayed at estates across the Mediterranean — Amalfi, Côte d\'Azur, Mallorca. Casa Serena is the only one we\'ve returned to three times. It\'s not a place you visit. It\'s a place you miss.', name: 'James & Caroline H.', detail: 'London, UK · Stayed August 2024' },
  { quote: 'The silence. That\'s what I remember most. No music piped through speakers, no lobby chatter. Just the wind, the sea, and the occasional clink of a wine glass. Absolute perfection.', name: 'Sophie M.', detail: 'Paris, France · Stayed May 2024' },
  { quote: 'My wife said "I don\'t want to leave" on day two. We extended by a week. Nikos and his team made it feel effortless — as if the extra days had always been part of the plan.', name: 'David & Rachel K.', detail: 'New York, USA · Stayed June 2024' },
];

const faqs = [
  { q: 'What is the minimum stay?', a: '3 nights year-round, with a 5-night minimum during July and August. We find this allows guests to truly settle into the rhythm of the estate.' },
  { q: 'Is the estate suitable for children?', a: 'Absolutely. We welcome families and can arrange childproofing, high chairs, cots, and vetted childcare. Please note the property has unfenced cliff edges and an infinity pool — supervision is required for young children.' },
  { q: 'How do I get to the estate from the airport?', a: 'We provide complimentary private transfers in our Mercedes V-Class for all guests. The drive from Santorini Airport takes approximately 25 minutes. Helicopter transfers from Athens or Mykonos can also be arranged.' },
  { q: 'Can I book the entire estate exclusively?', a: 'Yes. Full estate buyouts are available for up to 16 guests across all four suites. This is popular for celebrations, retreats, and family gatherings. Contact us for exclusive-use pricing.' },
  { q: 'What is your cancellation policy?', a: 'Cancellations 60+ days before arrival receive a full refund minus a €200 fee. 30–59 days: 50% retained. Less than 30 days: no refund. We strongly recommend travel insurance.' },
  { q: 'Is Wi-Fi available?', a: 'Yes — high-speed fibre Wi-Fi is available throughout the estate, including all outdoor terraces and the pool area. We also offer a "digital detox" option where we can disable connectivity in your suite on request.' },
];
---

<Layout>
  <Nav />
  <main>
    <Hero />
    <Intro />
    <Gallery />
    <Amenities />

    <!-- Testimonials -->
    <section data-nav-theme="dark" class="bg-charcoal overflow-hidden">
      <div class="relative min-h-[60vh] md:min-h-[70vh] flex flex-col justify-between section-px py-16 md:py-24">
        <p class="label-xs text-driftwood">Guest Voices</p>

        <div id="testimonial-track" class="mt-12 md:mt-0">
          {testimonials.map((t, i) => (
            <blockquote
              data-testimonial={i}
              class:list={["transition-opacity duration-700", i !== 0 && "hidden"]}
            >
              <p class="font-serif italic text-cream font-light leading-tight heading-lg max-w-4xl">
                &ldquo;{t.quote}&rdquo;
              </p>
              <footer class="mt-8 md:mt-12">
                <span class="text-cream/40 text-xs tracking-widest">{t.name}</span>
                <span class="text-driftwood/50 text-xs ml-4">{t.detail}</span>
              </footer>
            </blockquote>
          ))}
        </div>

        <!-- Dots + counter -->
        <div class="flex items-center gap-6 mt-10 md:mt-0">
          <div class="flex gap-2" id="testimonial-dots">
            {testimonials.map((_, i) => (
              <button
                data-dot={i}
                aria-label={`Testimonial ${i + 1}`}
                class:list={["w-6 h-px transition-all duration-300", i === 0 ? "bg-terracotta" : "bg-cream/20"]}
              />
            ))}
          </div>
          <span id="testimonial-counter" class="label-xs text-driftwood/50">1 / {testimonials.length}</span>
        </div>
      </div>
    </section>

    <script>
      const quotes = document.querySelectorAll<HTMLElement>('[data-testimonial]');
      const dots = document.querySelectorAll<HTMLButtonElement>('[data-dot]');
      const counter = document.getElementById('testimonial-counter')!;
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      function show(i: number) {
        quotes[current]!.classList.add('hidden');
        dots[current]!.classList.replace('bg-terracotta', 'bg-cream/20');
        current = i;
        quotes[current]!.classList.remove('hidden');
        dots[current]!.classList.replace('bg-cream/20', 'bg-terracotta');
        counter.textContent = `${current + 1} / ${quotes.length}`;
      }

      dots.forEach((dot, i) => dot.addEventListener('click', () => { clearInterval(timer); show(i); startTimer(); }));

      function startTimer() { timer = setInterval(() => show((current + 1) % quotes.length), 6000); }
      startTimer();
    </script>

    <!-- FAQ -->
    <section data-nav-theme="light" class="bg-warm-white py-28 md:py-40 section-px">
      <div class="max-w-2xl mx-auto">
        <p class="label-xs text-driftwood mb-12">Common Questions</p>
        {faqs.map(({ q, a }) => (
          <details class="group border-b border-charcoal/10 py-5">
            <summary class="flex justify-between items-center list-none text-charcoal font-medium text-sm md:text-base">
              {q}
              <span class="text-driftwood text-lg leading-none transition-transform duration-200 group-open:rotate-45 shrink-0 ml-4">+</span>
            </summary>
            <p class="text-charcoal/55 text-sm font-light leading-relaxed mt-4 pr-8">{a}</p>
          </details>
        ))}
      </div>
    </section>

    <Location />
    <Enquire />
  </main>
</Layout>
