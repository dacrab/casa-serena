---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Enquire from '../components/Enquire.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Enquire — Casa Serena | Santorini" description="Reserve your stay at Casa Serena. Contact us to check availability and book your suite.">
  <Nav />
  <main>
    <section class="relative h-[40vh] flex items-end overflow-hidden bg-charcoal">
      <div class="relative section-px pb-12 w-full">
        <p data-intro class="label-xs text-cream/50 mb-3">Reservations</p>
        <h1 data-intro class="font-serif italic font-light text-cream heading-hero leading-none">Enquire</h1>
      </div>
    </section>
    <Enquire />
  </main>
  <Footer />
  <script>
    const suite = new URLSearchParams(location.search).get('suite');
    if (suite) {
      const sel = document.getElementById('suite') as HTMLSelectElement | null;
      if (sel) sel.value = suite;
    }
  </script>
</Layout>
