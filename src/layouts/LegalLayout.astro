---
import PageLayout from './PageLayout.astro';
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<PageLayout {title} {description} mainClass="flex-1 bg-paper">
  <section class="shell pb-20 pt-32 md:pb-28 md:pt-40">
    <div class="grid gap-10 md:grid-cols-12">
      <aside class="md:col-span-3">
        <p data-intro class="label text-ink-soft">Legal</p>
        <p data-intro class="mt-3 text-sm leading-relaxed text-ink-soft/80">Last updated<br />{site.lastUpdated}</p>
        <a data-intro href="/" class="link-line mt-8">Back to the estate</a>
      </aside>

      <article class="prose-cs md:col-span-7 md:col-start-6">
        <h1 data-intro>{heading}</h1>
        <slot />
      </article>
    </div>
  </section>
</PageLayout>
